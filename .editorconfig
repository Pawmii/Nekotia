root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,neko}]
indent_style = space
indent_size = 4

[*.{cpp,hpp,S}]
indent_style = space
indent_size = 4

[*.{json,csproj,props,slnx}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
