// ICMP: answers echo requests (ping) and lets the kernel ping others.
using Nekotia;
using Nekotia.Hal;
using Nekotia.Mem;
using Nekotia.Processes;
using Nekotia.Threading;

namespace Nekotia.OS.Net;

public static unsafe class Icmp
{
    public const ushort Identifier = 0x4E4B;   // "NK"

    // The latest echo reply to us (Lock held to write).
    static int _replySeq = -1;
    static uint _replyFrom;
    static byte _replyTtl;
    static int _replyBytes;
    static Semaphore _replied;   // a reply arrived (the waiter checks whether it is the one it wants)
    public static ulong EchoesAnswered;

    public static void Receive(uint source, byte* p, int length, byte ttl)
    {
        if (length < 8 || Stack.Checksum(p, length) != 0)
            return;
        if (p[0] == 8 && p[1] == 0) {   // echo request → echo reply with the same data
            byte* q = Stack.Payload();
            Memory.Copy(q, p, (nuint)length);
            q[0] = 0;
            Stack.Put16(q + 2, 0);
            Stack.Put16(q + 2, Stack.Checksum(q, length));
            Ip.Send(Ip.ProtoIcmp, source, length);
            EchoesAnswered++;
        } else if (p[0] == 3 && length >= 8 + 20 + 4) {   // unreachable: which of our datagrams it was about
            int quotedHeader = (p[8] & 15) * 4;
            if (p[8 + 9] == Ip.ProtoUdp && length >= 8 + quotedHeader + 4) {
                LastUnreachablePort = Stack.Get16(p + 8 + quotedHeader + 2);
                UnreachablesReceived++;
            }
        } else if (p[0] == 0 && Stack.Get16(p + 4) == Identifier) {
            _replyFrom = source;
            _replyTtl = ttl;
            _replyBytes = length;
            _replySeq = Stack.Get16(p + 6);
            _replied.Signal();
        }
    }

    public const byte CodeNetUnreachable = 0, CodeHostUnreachable = 1, CodeProtocolUnreachable = 2, CodePortUnreachable = 3;
    public static ulong UnreachablesSent, UnreachablesReceived;
    public static ushort LastUnreachablePort;   // UDP port of the last "port unreachable" we got
    static ulong _unreachableSecond, _unreachableThisSecond;

    /// "Destination unreachable" back to `destination` about the datagram whose IP header is `ip` (RFC 792:
    /// its header and first 8 data bytes go along). At most 10 a second. Lock held.
    public static void Unreachable(uint destination, byte* ip, int headerLength, byte code)
    {
        ulong second = Time.UptimeMs() / 1000;
        if (second != _unreachableSecond) {
            _unreachableSecond = second;
            _unreachableThisSecond = 0;
        }
        if (++_unreachableThisSecond > 10)
            return;
        int quoted = headerLength + 8;
        int total = Stack.Get16(ip + 2);
        if (quoted > total)
            quoted = total;
        byte* q = Stack.Payload();
        q[0] = 3;   // destination unreachable
        q[1] = code;
        Stack.Put16(q + 2, 0);
        Stack.Put32(q + 4, 0);
        Memory.Copy(q + 8, ip, (nuint)quoted);
        Stack.Put16(q + 2, Stack.Checksum(q, 8 + quoted));
        Ip.Send(Ip.ProtoIcmp, destination, 8 + quoted);
        UnreachablesSent++;
    }

    /// Sends echo request `sequence` with `size` data bytes (Lock taken here).
    public static long SendEcho(uint destination, ushort sequence, int size)
    {
        lock (Stack.Lock) {
            byte* q = Stack.Payload();
            q[0] = 8;
            q[1] = 0;
            Stack.Put16(q + 2, 0);
            Stack.Put16(q + 4, Identifier);
            Stack.Put16(q + 6, sequence);
            for int i in 0..size { q[8 + i] = (byte)(i + 0x20); }
            Stack.Put16(q + 2, Stack.Checksum(q, 8 + size));
            return Ip.Send(Ip.ProtoIcmp, destination, 8 + size);
        }
    }

    /// Waits for the reply to `sequence`; false after `timeoutMs`.
    public static bool WaitReply(ushort sequence, ulong timeoutMs, out byte ttl, out int bytes)
    {
        ulong until = Time.UptimeMs() + timeoutMs;
        loop {
            if (_replySeq == sequence) {
                ttl = _replyTtl;
                bytes = _replyBytes;
                return true;
            }
            ulong now = Time.UptimeMs();
            if (now >= until || _replied.WaitFor(until - now) < 0)
                break;
        }
        ttl = 0;
        bytes = 0;
        return false;
    }
}
