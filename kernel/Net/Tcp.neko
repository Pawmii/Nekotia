// TCP (RFC 9293): connect, listen/accept, reliable ordered byte streams both ways, graceful close with FIN in
// both directions, RST, TIME_WAIT, and what makes it hold up on a real network:
//
//   RTT estimation      RFC 6298: SRTT/RTTVAR from one timed segment at a time (Karn: never a retransmitted
//                       one), RTO = SRTT + 4·RTTVAR within [200 ms, 8 s], doubled on every timeout
//   congestion control  RFC 5681: slow start from 10 segments (RFC 6928), congestion avoidance, fast
//                       retransmit after 3 duplicate ACKs, fast recovery with NewReno partial ACKs (RFC 6582);
//                       a timeout falls back to one segment and resends everything unacknowledged
//   reassembly          segments that arrive out of order are kept in the receive ring (up to 8 holes)
//                       and reported with SACK blocks (RFC 2018); in-order data then fills the gap
//   SACK recovery       the peer's SACK blocks form a scoreboard; in fast recovery every duplicate or
//                       partial ACK resends the next hole below the highest SACKed byte (RFC 6675's NextSeg),
//                       so several losses in one window are repaired in about one round trip
//   window scaling      RFC 7323: 128 KiB buffers, our shift 2; used when the peer offers it too
//   flow control        the peer's window (zero-window probes), and window updates after reads
//
// Not done: timestamps, urgent data, delayed ACKs, Nagle.
//
// Everything runs under Stack.Lock: segments from the net-rx thread, Tick() from net-timer every
// 100 ms, and the calls below from whoever uses a connection. Callers that must wait (accept,
// connect, a full send buffer, an empty receive buffer) register on the connection's event and
// sleep with the lock released; every state change wakes them (Notify) and they look again.
using Nekotia;
using Nekotia.Hal;
using Nekotia.Mem;
using Nekotia.Processes;
using Nekotia.Threading;

namespace Nekotia.OS.Net;

public enum TcpState : byte
{
    Closed = 0, Listen, SynSent, SynReceived, Established,
    FinWait1, FinWait2, CloseWait, Closing, LastAck, TimeWait,
}

public unsafe struct TcpConnection
{
    public bool Used;
    public TcpState State;
    public bool Open;          // the owner has not called Close yet
    public bool FinQueued;     // Close was called: send FIN once the buffer is out
    public bool FinSent;
    public bool Reset;         // ended by RST or by giving up retransmitting
    public bool Refused;
    public uint Owner;         // pid, 0 = kernel
    public int Parent;         // listening connection that created it (until accepted), else -1
    public bool Accepted;

    public uint LocalIp, RemoteIp;
    public ushort LocalPort, RemotePort;

    public uint SendUnacked;   // SND.UNA
    public uint SendNext;      // SND.NXT
    public uint HighWater;     // SND.MAX: highest SendNext so far (a timeout sends SendNext back; ACKs up to here count)
    public uint FinSequence;   // where our FIN is (valid once FinSent was set at least once)
    public bool FinEverSent;
    public uint SendWindow;    // what the peer accepts beyond SendUnacked (scaled)
    public uint ReceiveNext;   // RCV.NXT
    public ushort PeerMss;
    public uint AdvertisedEdge; // ReceiveNext + the window we last advertised

    // options agreed in the handshake
    public byte SendScale;     // the peer's window shift (0 without scaling)
    public byte ReceiveScale;  // ours
    public bool SackOk;

    // congestion control (bytes)
    public uint Cwnd, Ssthresh;
    public int DupAcks;
    public bool InRecovery;
    public uint Recover;       // SendNext when fast recovery began
    public fixed uint Sacked[8];  // what the peer's SACK blocks say it has beyond SendUnacked, pairs [start, end)
    public int SackedCount;
    public uint RetransmitMark;   // in recovery: holes below this have been resent already

    // round-trip time (ms; Srtt scaled by 8, Rttvar by 4 — Jacobson's integer form)
    public long Srtt, Rttvar;
    public bool RttTiming;
    public uint RttSequence;   // the timed segment is acknowledged when ACK passes this
    public ulong RttStart;

    public byte* SendBuffer;   // ring: bytes from SendUnacked on (sent but unacknowledged, then unsent)
    public int SendHead, SendCount;
    public byte* ReceiveBuffer;  // ring: in-order bytes not read yet, then room (where out-of-order data waits)
    public int ReceiveHead, ReceiveCount;
    public fixed uint Holes[16];  // received ranges beyond ReceiveNext, [start, end) sequence numbers, pairs
    public int HoleCount;

    public ulong RetransmitAt; // 0 = timer off
    public ulong Rto;
    public int Retries;
    public ulong TimeWaitUntil;

    public int Waiters;
    public Semaphore Event;
}

public static unsafe class Tcp
{
    public const int Connections = 32;
    public const int BufferSize = 131072;   // each way, per connection (allocated on first use)
    public const int Mss = 1460;
    const byte OurScale = 2;                 // 128 KiB >> 2 fits the 16-bit window field
    const byte Fin = 1, Syn = 2, Rst = 4, Psh = 8, Ack = 16;
    const ulong InitialRto = 1000, MinRto = 200, MaxRto = 8000;
    const int MaxRetries = 8;
    const int MaxHoles = 8;

    public static TcpConnection* Table;
    static ushort _ephemeral = 50000;
    public static ulong Retransmits, FastRetransmits, ResetsSent, OutOfOrderKept;

    public static void Init()
    {
        Table = Heap.NewArray<TcpConnection>(Connections);
        Thread.Start("net-timer", &TimerLoop, 0, ThreadPriority.High);
    }

    static bool Before(uint a, uint b) => (int)(a - b) < 0;
    static bool BeforeOrSame(uint a, uint b) => (int)(a - b) <= 0;
    static uint Min(uint a, uint b) => a < b ? a : b;
    static uint Max(uint a, uint b) => a > b ? a : b;

    static void Notify(TcpConnection* c)
    {
        while (c->Waiters > 0) {
            c->Waiters--;
            c->Event.Signal();
        }
    }

    /// Releases Stack.Lock, sleeps until the connection changes, takes the lock again. False when killed.
    static bool Wait(TcpConnection* c)
    {
        c->Waiters++;
        Stack.Lock.Unlock();
        bool ok = c->Event.WaitInterruptible();
        Stack.Lock.Lock();
        return ok;
    }

    static int Allocate(uint owner)
    {
        for int i in 0..Connections {
            TcpConnection* c = &Table[i];
            if (c->Used)
                continue;
            byte* send = c->SendBuffer;
            byte* receive = c->ReceiveBuffer;
            if (send == null)
                send = (byte*)Heap.Alloc(BufferSize);
            if (receive == null)
                receive = (byte*)Heap.Alloc(BufferSize);
            if (send == null || receive == null)
                return (int)Process.ErrNoMemory;
            // Every field but the semaphore (a thread just woken from it may still be on its way out).
            c->State = TcpState.Closed;
            c->FinQueued = false;
            c->FinSent = false;
            c->Reset = false;
            c->Refused = false;
            c->Accepted = false;
            c->LocalIp = 0;
            c->RemoteIp = 0;
            c->LocalPort = 0;
            c->RemotePort = 0;
            c->SendUnacked = 0;
            c->SendNext = 0;
            c->HighWater = 0;
            c->FinSequence = 0;
            c->FinEverSent = false;
            c->SendWindow = 0;
            c->ReceiveNext = 0;
            c->AdvertisedEdge = 0;
            c->SendScale = 0;
            c->ReceiveScale = 0;
            c->SackOk = false;
            c->Cwnd = 10 * Mss;
            c->Ssthresh = 0xFFFFFFFF;
            c->DupAcks = 0;
            c->InRecovery = false;
            c->Recover = 0;
            c->SackedCount = 0;
            c->RetransmitMark = 0;
            c->Srtt = 0;
            c->Rttvar = 0;
            c->RttTiming = false;
            c->SendHead = 0;
            c->SendCount = 0;
            c->ReceiveHead = 0;
            c->ReceiveCount = 0;
            c->HoleCount = 0;
            c->RetransmitAt = 0;
            c->Retries = 0;
            c->TimeWaitUntil = 0;
            c->Waiters = 0;
            c->SendBuffer = send;
            c->ReceiveBuffer = receive;
            c->Used = true;
            c->Open = true;
            c->Owner = owner;
            c->Parent = -1;
            c->PeerMss = 536;
            c->Rto = InitialRto;
            return i;
        }
        return (int)Process.ErrTooManyFiles;
    }

    static void Free(TcpConnection* c)
    {
        c->Used = false;
        c->State = TcpState.Closed;
        Notify(c);
    }

    static TcpConnection* Get(int h) => h >= 0 && h < Connections && Table[h].Used ? &Table[h] : null;

    static bool PortInUse(ushort port)
    {
        for int i in 0..Connections {
            if (Table[i].Used && Table[i].LocalPort == port)
                return true;
        }
        return false;
    }

    static uint InitialSequence() => (uint)(Cpu.ReadTimestamp() >> 4);

    /// Data bytes per segment: the peer's MSS, minus room for SACK blocks while we report holes.
    static int SegmentSize(TcpConnection* c) => (c->PeerMss < Mss ? c->PeerMss : Mss) - (c->SackOk && c->HoleCount > 0 ? 28 : 0);

    // ---------------------------------------------------------------- output

    /// Free room in the receive ring, as the window we offer (unscaled bytes).
    static uint FreeRoom(TcpConnection* c) => (uint)(BufferSize - c->ReceiveCount);

    /// One segment with `length` bytes of the send ring at `offset` (from SendUnacked). Lock held.
    static void Segment(TcpConnection* c, uint sequence, byte flags, int offset, int length)
    {
        byte* t = Stack.Payload();
        bool syn = (flags & Syn) != 0;
        // Options: in SYNs MSS, window scale and SACK-permitted; later SACK blocks while we have holes.
        int options = 0;
        byte* o = t + 20;
        if (syn) {
            o[0] = 2;
            o[1] = 4;
            Stack.Put16(o + 2, Mss);
            options = 4;
            bool active = (flags & Ack) == 0;   // our SYN offers; our SYN-ACK only answers what the peer offered
            if (active || c->ReceiveScale != 0) {
                o[4] = 1;   // NOP
                o[5] = 3;
                o[6] = 3;
                o[7] = OurScale;
                options = 8;
            }
            if (active || c->SackOk) {
                o[options] = 1;
                o[options + 1] = 1;
                o[options + 2] = 4;   // SACK permitted
                o[options + 3] = 2;
                options += 4;
            }
        } else if (c->SackOk && c->HoleCount > 0 && (flags & Ack) != 0) {
            int blocks = c->HoleCount < 3 ? c->HoleCount : 3;
            o[0] = 1;
            o[1] = 1;
            o[2] = 5;
            o[3] = (byte)(2 + 8 * blocks);
            for int b in 0..blocks {
                Stack.Put32(o + 4 + b * 8, c->Holes[b * 2]);
                Stack.Put32(o + 8 + b * 8, c->Holes[b * 2 + 1]);
            }
            options = 4 + 8 * blocks;
        }
        int header = 20 + options;
        Stack.Put16(t, c->LocalPort);
        Stack.Put16(t + 2, c->RemotePort);
        Stack.Put32(t + 4, sequence);
        Stack.Put32(t + 8, (flags & Ack) != 0 ? c->ReceiveNext : 0);
        t[12] = (byte)((header / 4) << 4);
        t[13] = flags;
        uint room = FreeRoom(c);
        uint field = syn ? Min(room, 65535) : Min(room >> c->ReceiveScale, 65535);   // SYNs are never scaled
        if ((flags & Ack) != 0)
            c->AdvertisedEdge = c->ReceiveNext + (syn ? field : field << c->ReceiveScale);
        Stack.Put16(t + 14, field);
        Stack.Put32(t + 16, 0);   // checksum, urgent pointer
        for int i in 0..length {
            t[header + i] = c->SendBuffer[(c->SendHead + offset + i) % BufferSize];
        }
        int size = header + length;
        Stack.Put16(t + 16, Stack.Fold(Stack.Sum(t, size, Udp.Pseudo(c->LocalIp, c->RemoteIp, Ip.ProtoTcp, size))));
        Ip.Send(Ip.ProtoTcp, c->RemoteIp, size);
    }

    static void SendAck(TcpConnection* c) => Segment(c, c->SendNext, Ack, 0, 0);

    static void StartTimer(TcpConnection* c)
    {
        if (c->RetransmitAt == 0)
            c->RetransmitAt = Time.UptimeMs() + c->Rto;
    }

    static bool CanSend(TcpConnection* c) =>
        c->State == TcpState.Established || c->State == TcpState.CloseWait || c->State == TcpState.FinWait1
        || c->State == TcpState.LastAck || c->State == TcpState.Closing;

    /// Sends what both windows (the peer's and the congestion window) allow, then the FIN once
    /// everything is out. Lock held.
    static void Output(TcpConnection* c)
    {
        if (!CanSend(c))
            return;
        int mss = SegmentSize(c);
        uint window = Min(c->SendWindow, c->Cwnd);
        loop {
            int inFlight = (int)(c->SendNext - c->SendUnacked) - (c->FinSent ? 1 : 0);
            int unsent = c->SendCount - inFlight;
            int room = (int)window - inFlight;
            if (unsent <= 0 || room <= 0 || c->FinSent)
                break;
            int n = unsent < mss ? unsent : mss;
            if (n > room) {
                if (inFlight > 0 && room < mss)
                    break;   // a small window: wait for a full segment's worth (sender-side silly window avoidance)
                n = room;
            }
            Segment(c, c->SendNext, (byte)(Ack | Psh), inFlight, n);
            if (!c->RttTiming && !Before(c->SendNext, c->HighWater)) {   // time this one (new data only: Karn)
                c->RttTiming = true;
                c->RttSequence = c->SendNext + (uint)n;
                c->RttStart = Time.UptimeMs();
            }
            c->SendNext += (uint)n;
            if (Before(c->HighWater, c->SendNext))
                c->HighWater = c->SendNext;
            StartTimer(c);
        }
        int pending = c->SendCount - (int)(c->SendNext - c->SendUnacked);
        if (c->FinQueued && !c->FinSent && pending <= 0) {
            Segment(c, c->SendNext, (byte)(Fin | Ack), 0, 0);
            c->FinSequence = c->SendNext;
            c->FinEverSent = true;
            c->SendNext++;
            if (Before(c->HighWater, c->SendNext))
                c->HighWater = c->SendNext;
            c->FinSent = true;
            if (c->State == TcpState.Established)
                c->State = TcpState.FinWait1;
            else if (c->State == TcpState.CloseWait)
                c->State = TcpState.LastAck;
            StartTimer(c);
        }
    }

    /// The first unacknowledged segment again (fast retransmit, partial ACK, timeout).
    static void RetransmitFirst(TcpConnection* c)
    {
        int inFlight = (int)(c->SendNext - c->SendUnacked) - (c->FinSent ? 1 : 0);
        int mss = SegmentSize(c);
        Retransmits++;
        c->RttTiming = false;   // Karn: no RTT sample from a segment sent twice
        if (inFlight > 0)
            Segment(c, c->SendUnacked, (byte)(Ack | Psh), 0, inFlight < mss ? inFlight : mss);
        else if (c->FinSent)
            Segment(c, c->SendNext - 1, (byte)(Fin | Ack), 0, 0);
    }

    /// RST in answer to a segment that belongs to nothing (Lock held).
    static void Refuse(uint source, uint destination, byte* t, int length, int dataLength)
    {
        if ((t[13] & Rst) != 0)
            return;
        byte* r = Stack.Payload();
        uint seq = (t[13] & Ack) != 0 ? Stack.Get32(t + 8) : 0;
        uint ack = Stack.Get32(t + 4) + (uint)dataLength + ((t[13] & Syn) != 0 ? 1u : 0u) + ((t[13] & Fin) != 0 ? 1u : 0u);
        Stack.Put16(r, Stack.Get16(t + 2));
        Stack.Put16(r + 2, Stack.Get16(t));
        Stack.Put32(r + 4, seq);
        Stack.Put32(r + 8, ack);
        r[12] = 5 << 4;
        r[13] = (t[13] & Ack) != 0 ? Rst : (byte)(Rst | Ack);
        Stack.Put32(r + 14, 0);
        Stack.Put16(r + 18, 0);
        Stack.Put16(r + 16, Stack.Fold(Stack.Sum(r, 20, Udp.Pseudo(destination, source, Ip.ProtoTcp, 20))));
        Ip.Send(Ip.ProtoTcp, source, 20);
        ResetsSent++;
    }

    // ---------------------------------------------------------------- round trip and congestion

    /// RFC 6298 with Jacobson's scaled integers: Srtt = 8·SRTT, Rttvar = 4·RTTVAR.
    static void RttSample(TcpConnection* c, long ms)
    {
        if (ms < 1)
            ms = 1;
        if (c->Srtt == 0) {
            c->Srtt = ms << 3;
            c->Rttvar = ms << 1;
        } else {
            long delta = ms - (c->Srtt >> 3);
            c->Srtt += delta;
            if (delta < 0)
                delta = -delta;
            c->Rttvar += delta - (c->Rttvar >> 2);
        }
        long rto = (c->Srtt >> 3) + (c->Rttvar > 25 ? c->Rttvar : 25);   // + max(timer granularity, 4·RTTVAR)
        c->Rto = rto < (long)MinRto ? MinRto : rto > (long)MaxRto ? MaxRto : (ulong)rto;
    }

    /// New data acknowledged (`acked` bytes): grow the congestion window, or leave/continue fast recovery.
    static void OnNewAck(TcpConnection* c, uint ack, int acked)
    {
        uint mss = (uint)SegmentSize(c);
        c->DupAcks = 0;
        if (c->InRecovery) {
            if (!Before(ack, c->Recover)) {   // everything sent before the loss is through: recovery is over
                c->InRecovery = false;
                c->Cwnd = c->Ssthresh;
            } else {                           // partial ACK: the next hole, resent at once (NewReno)
                if (Before(c->RetransmitMark, ack))
                    c->RetransmitMark = ack;
                if (!RetransmitNextHole(c))
                    RetransmitFirst(c);
                c->Cwnd = c->Cwnd > (uint)acked ? c->Cwnd - (uint)acked + mss : mss;
            }
            return;
        }
        if (c->Cwnd < c->Ssthresh)
            c->Cwnd += Min((uint)acked, mss);                // slow start: doubles every round trip
        else
            c->Cwnd += Max(mss * mss / c->Cwnd, 1);           // congestion avoidance: one segment per round trip
    }

    static void OnDuplicateAck(TcpConnection* c)
    {
        uint mss = (uint)SegmentSize(c);
        c->DupAcks++;
        if (c->InRecovery) {
            c->Cwnd += mss;          // a segment has left the network
            RetransmitNextHole(c);   // SACK says what else is missing: repair it now, not a round trip later
            return;
        }
        if (c->DupAcks == 3) {   // fast retransmit
            uint flight = c->SendNext - c->SendUnacked;
            c->Ssthresh = Max(flight / 2, 2 * mss);
            FastRetransmits++;
            RetransmitFirst(c);
            c->Cwnd = c->Ssthresh + 3 * mss;
            c->InRecovery = true;
            c->Recover = c->SendNext;
            c->RetransmitMark = c->SendUnacked + Min(flight, mss);
        }
    }

    /// Takes the peer's SACK blocks from an ACK into the scoreboard (ranges above SendUnacked, merged).
    static void ReadSack(TcpConnection* c, byte* t, int header)
    {
        // forget what the cumulative ACK has passed
        for (int i = 0; i < c->SackedCount; i++) {
            if (BeforeOrSame(c->Sacked[i * 2 + 1], c->SendUnacked)) {
                RemoveSacked(c, i);
                i--;
            } else if (Before(c->Sacked[i * 2], c->SendUnacked)) {
                c->Sacked[i * 2] = c->SendUnacked;
            }
        }
        for (int i = 20; i + 1 < header;) {
            byte kind = t[i];
            if (kind == 0)
                break;
            if (kind == 1) {
                i++;
                continue;
            }
            byte len = t[i + 1];
            if (len < 2 || i + len > header)
                break;
            if (kind == 5) {
                for (int b = i + 2; b + 8 <= i + len; b += 8) {
                    uint s = Stack.Get32(t + b), e = Stack.Get32(t + b + 4);
                    if (Before(c->SendUnacked, s) && Before(s, e) && BeforeOrSame(e, c->HighWater))
                        AddSacked(c, s, e);
                }
            }
            i += len;
        }
    }

    static void AddSacked(TcpConnection* c, uint start, uint end)
    {
        for (int i = 0; i < c->SackedCount; i++) {
            uint s = c->Sacked[i * 2], e = c->Sacked[i * 2 + 1];
            if (Before(end, s) || Before(e, start))
                continue;
            if (Before(s, start))
                start = s;
            if (Before(end, e))
                end = e;
            RemoveSacked(c, i);
            i = -1;
        }
        if (c->SackedCount == 4) {   // full: the lowest block goes (it is the oldest news)
            int low = 0;
            for (int i = 1; i < 4; i++) {
                if (Before(c->Sacked[i * 2], c->Sacked[low * 2]))
                    low = i;
            }
            RemoveSacked(c, low);
        }
        c->Sacked[c->SackedCount * 2] = start;
        c->Sacked[c->SackedCount * 2 + 1] = end;
        c->SackedCount++;
    }

    static void RemoveSacked(TcpConnection* c, int i)
    {
        for (int j = i + 1; j < c->SackedCount; j++) {
            c->Sacked[(j - 1) * 2] = c->Sacked[j * 2];
            c->Sacked[(j - 1) * 2 + 1] = c->Sacked[j * 2 + 1];
        }
        c->SackedCount--;
    }

    /// In recovery: resends the lowest range the peer has not got (below its highest SACKed byte) that was
    /// not resent yet in this recovery (a simple RFC 6675 NextSeg). False when there is none.
    static bool RetransmitNextHole(TcpConnection* c)
    {
        if (c->SackedCount == 0)
            return false;
        uint top = c->SendUnacked;
        for (int i = 0; i < c->SackedCount; i++) {
            if (Before(top, c->Sacked[i * 2 + 1]))
                top = c->Sacked[i * 2 + 1];
        }
        uint seq = Before(c->SendUnacked, c->RetransmitMark) ? c->RetransmitMark : c->SendUnacked;
        bool moved = true;
        while (moved) {   // skip what the peer has
            moved = false;
            for (int i = 0; i < c->SackedCount; i++) {
                if (!Before(seq, c->Sacked[i * 2]) && Before(seq, c->Sacked[i * 2 + 1])) {
                    seq = c->Sacked[i * 2 + 1];
                    moved = true;
                }
            }
        }
        if (!Before(seq, top))
            return false;   // nothing missing below the highest SACKed byte
        uint end = top;     // up to the next SACKed block
        for (int i = 0; i < c->SackedCount; i++) {
            if (Before(seq, c->Sacked[i * 2]) && Before(c->Sacked[i * 2], end))
                end = c->Sacked[i * 2];
        }
        int length = (int)(end - seq);
        int mss = SegmentSize(c);
        if (length > mss)
            length = mss;
        int offset = (int)(seq - c->SendUnacked);
        int dataInFlight = (int)(c->HighWater - c->SendUnacked) - (c->FinEverSent ? 1 : 0);
        if (offset + length > c->SendCount)
            length = c->SendCount - offset;
        if (length <= 0 || offset >= dataInFlight)
            return false;
        Retransmits++;
        c->RttTiming = false;
        Segment(c, seq, (byte)(Ack | Psh), offset, length);
        c->RetransmitMark = seq + (uint)length;
        return true;
    }

    // ---------------------------------------------------------------- reassembly

    /// Puts `length` bytes of `data` that start `offset` bytes after ReceiveNext into the ring. Returns how
    /// many fit (the window is the ring's free room).
    static int Store(TcpConnection* c, int offset, byte* data, int length)
    {
        int room = BufferSize - c->ReceiveCount;
        if (offset >= room)
            return 0;
        int n = length < room - offset ? length : room - offset;
        int at = c->ReceiveHead + c->ReceiveCount + offset;
        for int i in 0..n {
            c->ReceiveBuffer[(at + i) % BufferSize] = data[i];
        }
        return n;
    }

    /// Remembers [start, end) as received beyond ReceiveNext, merging with what touches it. False when full.
    static bool AddHole(TcpConnection* c, uint start, uint end)
    {
        for (int i = 0; i < c->HoleCount; i++) {
            uint s = c->Holes[i * 2], e = c->Holes[i * 2 + 1];
            if (Before(end, s) || Before(e, start))
                continue;   // separate
            if (Before(s, start))
                start = s;
            if (Before(end, e))
                end = e;
            RemoveHole(c, i);
            i = -1;   // the bigger range may now touch others: look again
        }
        if (c->HoleCount == MaxHoles)
            return false;
        // newest first: SACK reports the most recent block first (RFC 2018)
        for (int i = c->HoleCount; i > 0; i--) {
            c->Holes[i * 2] = c->Holes[(i - 1) * 2];
            c->Holes[i * 2 + 1] = c->Holes[(i - 1) * 2 + 1];
        }
        c->Holes[0] = start;
        c->Holes[1] = end;
        c->HoleCount++;
        return true;
    }

    static void RemoveHole(TcpConnection* c, int i)
    {
        for (int j = i + 1; j < c->HoleCount; j++) {
            c->Holes[(j - 1) * 2] = c->Holes[j * 2];
            c->Holes[(j - 1) * 2 + 1] = c->Holes[j * 2 + 1];
        }
        c->HoleCount--;
    }

    /// In-order data reached a kept range: take it in.
    static void Absorb(TcpConnection* c)
    {
        bool again = true;
        while (again) {
            again = false;
            for (int i = 0; i < c->HoleCount; i++) {
                uint s = c->Holes[i * 2], e = c->Holes[i * 2 + 1];
                if (Before(c->ReceiveNext, s))
                    continue;
                if (Before(c->ReceiveNext, e)) {
                    int more = (int)(e - c->ReceiveNext);
                    c->ReceiveCount += more;
                    c->ReceiveNext = e;
                }
                RemoveHole(c, i);
                again = true;
                break;
            }
        }
    }

    // ---------------------------------------------------------------- input

    public static void Receive(uint source, uint destination, byte* t, int length)
    {
        if (Table == null || length < 20 || Stack.Fold(Stack.Sum(t, length, Udp.Pseudo(source, destination, Ip.ProtoTcp, length))) != 0)
            return;
        int header = (t[12] >> 4) * 4;
        if (header < 20 || header > length)
            return;
        ushort sport = Stack.Get16(t);
        ushort dport = Stack.Get16(t + 2);
        uint seq = Stack.Get32(t + 4);
        uint ack = Stack.Get32(t + 8);
        byte flags = t[13];
        uint window = Stack.Get16(t + 14);
        byte* data = t + header;
        int dataLength = length - header;

        TcpConnection* c = null;
        int listener = -1;
        for int i in 0..Connections {
            TcpConnection* x = &Table[i];
            if (!x->Used || x->LocalPort != dport)
                continue;
            if (x->State == TcpState.Listen)
                listener = i;
            else if (x->State != TcpState.Closed && x->RemotePort == sport && x->RemoteIp == source)
                c = x;
        }
        if (c == null) {
            if (listener >= 0 && (flags & Syn) != 0 && (flags & (Ack | Rst)) == 0)
                Incoming(listener, source, destination, sport, dport, seq, window, t, header);
            else
                Refuse(source, destination, t, length, dataLength);
            return;
        }

        if ((flags & Rst) != 0) {   // reset: the connection is gone
            if (c->State == TcpState.SynSent)
                c->Refused = true;
            c->Reset = true;
            c->State = TcpState.Closed;
            c->RetransmitAt = 0;
            Notify(c);
            if (c->Parent >= 0 && !c->Accepted)
                Free(c);   // never handed out: nobody else will free it
            return;
        }

        if (c->State == TcpState.SynSent) {
            if ((flags & (Syn | Ack)) == (Syn | Ack) && ack == c->SendNext) {
                c->ReceiveNext = seq + 1;
                c->SendUnacked = ack;
                ReadOptions(c, t, header, true);
                c->SendWindow = window;   // the window in a SYN is never scaled
                c->State = TcpState.Established;
                c->RetransmitAt = 0;
                c->Retries = 0;
                if (c->RttStart != 0)   // 0: the SYN was sent twice (Karn)
                    RttSample(c, (long)(Time.UptimeMs() - c->RttStart));
                SendAck(c);
                Notify(c);
            }
            return;
        }

        // ACK: what the peer has received.
        if ((flags & Ack) != 0) {
            uint scaled = window << c->SendScale;
            // Up to SND.MAX: after a timeout SendNext went back, but the peer may already have had more.
            if (Before(c->SendUnacked, ack) && BeforeOrSame(ack, c->HighWater)) {
                if (Before(c->SendNext, ack))
                    c->SendNext = ack;
                int acked = (int)(ack - c->SendUnacked);
                bool synAcked = c->State == TcpState.SynReceived;
                if (synAcked) {   // our SYN counts as one
                    acked--;
                    c->State = TcpState.Established;
                    TcpConnection* parent = c->Parent >= 0 ? &Table[c->Parent] : null;
                    if (parent != null)
                        Notify(parent);   // accept() can take it
                    if (c->RttStart != 0)
                        RttSample(c, (long)(Time.UptimeMs() - c->RttStart));
                }
                bool finAcked = c->FinEverSent && ack == c->FinSequence + 1;
                if (finAcked)
                    c->FinSent = true;   // even if a timeout had taken it back for resending
                int dataAcked = acked - (finAcked ? 1 : 0);
                if (dataAcked > c->SendCount)
                    dataAcked = c->SendCount;
                if (dataAcked > 0) {
                    c->SendHead = (c->SendHead + dataAcked) % BufferSize;
                    c->SendCount -= dataAcked;
                }
                if (c->RttTiming && !Before(ack, c->RttSequence)) {
                    c->RttTiming = false;
                    RttSample(c, (long)(Time.UptimeMs() - c->RttStart));
                }
                c->SendUnacked = ack;
                if (c->SackOk)
                    ReadSack(c, t, header);
                c->Retries = 0;
                c->RetransmitAt = c->SendUnacked == c->SendNext ? 0UL : Time.UptimeMs() + c->Rto;
                if (!synAcked && dataAcked > 0)
                    OnNewAck(c, ack, dataAcked);
                if (finAcked) {
                    if (c->State == TcpState.FinWait1)
                        c->State = TcpState.FinWait2;
                    else if (c->State == TcpState.Closing)
                        EnterTimeWait(c);
                    else if (c->State == TcpState.LastAck) {
                        c->State = TcpState.Closed;
                        if (!c->Open)
                            Free(c);
                    }
                }
                Notify(c);
            } else if (ack == c->SendUnacked && dataLength == 0 && (flags & (Syn | Fin)) == 0
                       && (scaled == c->SendWindow || HasSack(t, header)) && c->SendNext != c->SendUnacked && CanSend(c)) {
                // The peer got something after a hole. A window that moved (the reader took data) still
                // counts when SACK blocks prove it is about new segments (as Linux does).
                if (c->SackOk)
                    ReadSack(c, t, header);
                OnDuplicateAck(c);
            }
            if (c->State != TcpState.SynReceived)
                c->SendWindow = scaled;
        }
        if (c->State == TcpState.SynReceived || c->State == TcpState.Closed)
            return;
        if (c->State == TcpState.TimeWait) {   // the peer did not get our last ACK: repeat it
            if ((flags & Fin) != 0)
                SendAck(c);
            return;
        }

        // Data: in order goes straight in; ahead of a hole is kept for later; old bytes are trimmed.
        bool ackNow = false;
        bool accepting = c->State == TcpState.Established || c->State == TcpState.FinWait1 || c->State == TcpState.FinWait2;
        if (dataLength > 0) {
            ackNow = true;   // in order: acknowledge; out of order or duplicate: repeat our ACK (with SACK)
            int offset = (int)(seq - c->ReceiveNext);
            if (offset < 0) {   // starts with bytes we already have
                if (-offset >= dataLength) {
                    dataLength = 0;
                    flags = (byte)(flags & ~Fin);
                } else {
                    data += -offset;
                    dataLength += offset;
                    seq = c->ReceiveNext;
                    offset = 0;
                }
            }
            if (accepting && dataLength > 0) {
                int n = Store(c, offset, data, dataLength);
                if (n < dataLength)
                    flags = (byte)(flags & ~Fin);   // the FIN is after bytes we could not take
                if (offset == 0 && n > 0) {
                    c->ReceiveCount += n;
                    c->ReceiveNext += (uint)n;
                    Absorb(c);
                    Notify(c);
                } else if (n > 0) {
                    if (AddHole(c, seq, seq + (uint)n))
                        OutOfOrderKept++;
                    flags = (byte)(flags & ~Fin);   // a FIN out of order: it comes again
                }
            }
        }
        if ((flags & Fin) != 0 && seq + (uint)dataLength == c->ReceiveNext) {
            c->ReceiveNext++;
            if (c->State == TcpState.Established)
                c->State = TcpState.CloseWait;
            else if (c->State == TcpState.FinWait1)
                c->State = TcpState.Closing;   // simultaneous close (our FIN not acked yet)
            else if (c->State == TcpState.FinWait2)
                EnterTimeWait(c);
            ackNow = true;
            Notify(c);
        }
        if (ackNow)
            SendAck(c);
        Output(c);   // the windows may have opened
    }

    static bool HasSack(byte* t, int header)
    {
        for (int i = 20; i + 1 < header;) {
            byte kind = t[i];
            if (kind == 0)
                return false;
            if (kind == 1) {
                i++;
                continue;
            }
            if (kind == 5)
                return true;
            byte len = t[i + 1];
            if (len < 2)
                return false;
            i += len;
        }
        return false;
    }

    /// MSS, window scale and SACK-permitted from a SYN (`synAck`: the answer to ours — scaling and SACK are on
    /// only when both sides offered them).
    static void ReadOptions(TcpConnection* c, byte* t, int header, bool synAck)
    {
        bool scale = false, sack = false;
        byte shift = 0;
        for (int i = 20; i < header;) {
            byte kind = t[i];
            if (kind == 0)
                break;
            if (kind == 1) {
                i++;
                continue;
            }
            if (i + 1 >= header)
                break;
            byte len = t[i + 1];
            if (len < 2 || i + len > header)
                break;
            if (kind == 2 && len == 4)
                c->PeerMss = Stack.Get16(t + i + 2);
            else if (kind == 3 && len == 3) {
                scale = true;
                shift = t[i + 2] > 14 ? (byte)14 : t[i + 2];
            } else if (kind == 4 && len == 2)
                sack = true;
            i += len;
        }
        // Our SYN offered both (active open); in a passive open we answer with what the peer offered.
        c->SendScale = scale ? shift : (byte)0;
        c->ReceiveScale = scale ? OurScale : (byte)0;
        c->SackOk = sack;
    }

    static void Incoming(int listener, uint source, uint destination, ushort sport, ushort dport, uint seq, uint window,
                         byte* t, int header)
    {
        int pending = 0;
        for int i in 0..Connections {
            if (Table[i].Used && Table[i].Parent == listener && !Table[i].Accepted)
                pending++;
        }
        if (pending >= 8)
            return;   // backlog full: the peer retries its SYN
        int h = Allocate(Table[listener].Owner);
        if (h < 0)
            return;
        TcpConnection* c = &Table[h];
        c->Parent = listener;
        c->State = TcpState.SynReceived;
        c->LocalIp = destination;
        c->LocalPort = dport;
        c->RemoteIp = source;
        c->RemotePort = sport;
        c->ReceiveNext = seq + 1;
        c->SendWindow = window;
        ReadOptions(c, t, header, false);
        uint iss = InitialSequence();
        c->SendUnacked = iss;
        c->SendNext = iss + 1;
        c->HighWater = iss + 1;
        c->RttStart = Time.UptimeMs();
        Segment(c, iss, (byte)(Syn | Ack), 0, 0);
        StartTimer(c);
    }

    static void EnterTimeWait(TcpConnection* c)
    {
        c->State = TcpState.TimeWait;
        c->RetransmitAt = 0;
        c->TimeWaitUntil = Time.UptimeMs() + 2000;   // 2 × MSL, shortened: we are not a router-crossing server farm
    }

    // ---------------------------------------------------------------- timer

    static void TimerLoop(ulong unused)
    {
        loop {
            Thread.Sleep(100);
            Sockets.ClosePending();
            lock (Stack.Lock) {
                Tick();
            }
        }
    }

    static void Tick()
    {
        ulong now = Time.UptimeMs();
        for int i in 0..Connections {
            TcpConnection* c = &Table[i];
            if (!c->Used)
                continue;
            if (c->State == TcpState.TimeWait && now >= c->TimeWaitUntil) {
                c->State = TcpState.Closed;
                if (!c->Open)
                    Free(c);
                else
                    Notify(c);
                continue;
            }
            if (c->State == TcpState.Closed && !c->Open) {
                Free(c);
                continue;
            }
            // Zero window: probe with one byte so we learn when it opens.
            int inFlight = (int)(c->SendNext - c->SendUnacked);
            if (c->State == TcpState.Established && c->SendWindow == 0 && inFlight == 0 && c->SendCount > 0) {
                c->SendWindow = 1;
                Output(c);
                c->SendWindow = 0;
                continue;
            }
            if (c->RetransmitAt == 0 || now < c->RetransmitAt)
                continue;
            if (++c->Retries > MaxRetries) {   // the peer is gone
                c->Reset = true;
                if (c->State == TcpState.SynSent)
                    c->Refused = true;
                c->State = TcpState.Closed;
                c->RetransmitAt = 0;
                Notify(c);
                if (!c->Open || (c->Parent >= 0 && !c->Accepted))
                    Free(c);
                continue;
            }
            c->RttTiming = false;
            c->RttStart = 0;   // a handshake segment sent twice gives no RTT sample
            if (c->State == TcpState.SynSent) {
                Retransmits++;
                Segment(c, c->SendUnacked, Syn, 0, 0);
            } else if (c->State == TcpState.SynReceived) {
                Retransmits++;
                Segment(c, c->SendUnacked, (byte)(Syn | Ack), 0, 0);
            } else {
                // A timeout means real loss: one segment at a time again, and everything after SND.UNA resent
                // (go back N) — the peer may have dropped what followed the hole.
                uint mss = (uint)SegmentSize(c);
                c->Ssthresh = Max((c->SendNext - c->SendUnacked) / 2, 2 * mss);
                c->Cwnd = mss;
                c->InRecovery = false;
                c->DupAcks = 0;
                c->SackedCount = 0;   // the peer may have dropped what it SACKed (RFC 2018 allows reneging)
                if (c->FinSent && c->SendCount > 0) {
                    c->FinSent = false;   // the FIN goes again after the data
                }
                c->SendNext = c->SendUnacked + (c->FinSent ? 1u : 0u);
                if (c->FinSent)
                    RetransmitFirst(c);
                else {
                    Retransmits++;
                    Output(c);
                }
            }
            c->Rto = c->Rto * 2 > MaxRto ? MaxRto : c->Rto * 2;
            c->RetransmitAt = now + c->Rto;
        }
    }

    // ---------------------------------------------------------------- the API (sleeps: call without the lock)

    /// A listening connection on `port`; its handle or a negative error.
    public static int Listen(ushort port, uint owner)
    {
        if (!Stack.Up)
            return (int)Process.ErrNoSyscall;
        lock (Stack.Lock) {
            for int i in 0..Connections {
                if (Table[i].Used && Table[i].State == TcpState.Listen && Table[i].LocalPort == port)
                    return (int)Process.ErrExists;
            }
            int h = Allocate(owner);
            if (h < 0)
                return h;
            Table[h].State = TcpState.Listen;
            Table[h].LocalPort = port;
            return h;
        }
    }

    /// Waits for the next established connection on `listener`; its handle or a negative error.
    public static int Accept(int listener)
    {
        Stack.Lock.Lock();
        defer Stack.Lock.Unlock();
        TcpConnection* l = Get(listener);
        if (l == null || l->State != TcpState.Listen)
            return (int)Process.ErrBadFd;
        loop {
            for int i in 0..Connections {
                TcpConnection* c = &Table[i];
                if (c->Used && c->Parent == listener && !c->Accepted && c->State != TcpState.SynReceived) {
                    c->Accepted = true;
                    c->Owner = l->Owner;
                    return i;
                }
            }
            if (!Wait(l))
                return (int)Process.ErrInterrupted;
            if (!l->Used || l->State != TcpState.Listen)
                return (int)Process.ErrBadFd;
        }
    }

    /// Connects to ip:port and waits for the handshake; the handle, or ErrNotFound (refused, no answer).
    public static int Connect(uint ip, ushort port, uint owner)
    {
        if (!Stack.Up)
            return (int)Process.ErrNoSyscall;
        byte* mac = stackalloc byte[6];
        if (!Stack.IsLocal(ip) && !Arp.Resolve(ip, mac))
            return (int)Process.ErrNotFound;
        Stack.Lock.Lock();
        defer Stack.Lock.Unlock();
        int h = Allocate(owner);
        if (h < 0)
            return h;
        TcpConnection* c = &Table[h];
        ushort local = 0;
        for int tries in 0..15000 {
            ushort p = _ephemeral++;
            if (_ephemeral < 50000)
                _ephemeral = 50000;
            if (!PortInUse(p)) {
                local = p;
                break;
            }
        }
        c->LocalPort = local;
        c->LocalIp = Stack.IsLocal(ip) && (ip >> 24) == 127 ? ip : Stack.Address;
        c->RemoteIp = ip;
        c->RemotePort = port;
        uint iss = InitialSequence();
        c->SendUnacked = iss;
        c->SendNext = iss + 1;
        c->HighWater = iss + 1;
        c->State = TcpState.SynSent;
        c->RttStart = Time.UptimeMs();
        Segment(c, iss, Syn, 0, 0);
        StartTimer(c);
        while (c->State == TcpState.SynSent) {
            if (!Wait(c)) {
                c->Open = false;
                c->State = TcpState.Closed;
                return (int)Process.ErrInterrupted;
            }
        }
        if (c->State != TcpState.Established) {
            c->Open = false;
            Free(c);
            return (int)Process.ErrNotFound;
        }
        return h;
    }

    /// Queues `length` bytes (waiting for room); bytes taken, or ErrBrokenPipe once the connection is gone.
    public static long Send(int h, byte* data, int length)
    {
        Stack.Lock.Lock();
        defer Stack.Lock.Unlock();
        TcpConnection* c = Get(h);
        if (c == null)
            return Process.ErrBadFd;
        int done = 0;
        while (done < length) {
            if (c->Reset || c->FinQueued || (c->State != TcpState.Established && c->State != TcpState.CloseWait))
                return done > 0 ? done : Process.ErrBrokenPipe;
            int room = BufferSize - c->SendCount;
            if (room == 0) {
                if (!Wait(c))
                    return done > 0 ? done : Process.ErrInterrupted;
                continue;
            }
            int n = length - done < room ? length - done : room;
            int tail = (c->SendHead + c->SendCount) % BufferSize;
            int first = n < BufferSize - tail ? n : BufferSize - tail;
            Memory.Copy(c->SendBuffer + tail, data + done, (nuint)first);
            if (n > first)
                Memory.Copy(c->SendBuffer, data + done + first, (nuint)(n - first));
            c->SendCount += n;
            done += n;
            Output(c);
        }
        return done;
    }

    /// Up to `capacity` received bytes (waits for some); 0 when the peer has closed its side.
    public static long Receive(int h, byte* buffer, int capacity)
    {
        Stack.Lock.Lock();
        defer Stack.Lock.Unlock();
        TcpConnection* c = Get(h);
        if (c == null)
            return Process.ErrBadFd;
        loop {
            if (c->ReceiveCount > 0) {
                int n = c->ReceiveCount < capacity ? c->ReceiveCount : capacity;
                int first = n < BufferSize - c->ReceiveHead ? n : BufferSize - c->ReceiveHead;
                Memory.Copy(buffer, c->ReceiveBuffer + c->ReceiveHead, (nuint)first);
                if (n > first)
                    Memory.Copy(buffer + first, c->ReceiveBuffer, (nuint)(n - first));
                c->ReceiveHead = (c->ReceiveHead + n) % BufferSize;
                c->ReceiveCount -= n;
                // Window update once the right edge moved by a full segment: a sender that saw a small
                // window waits for a big one (silly window avoidance), so it must be told.
                uint edge = c->ReceiveNext + FreeRoom(c);
                bool receiving = c->State == TcpState.Established || c->State == TcpState.FinWait1 || c->State == TcpState.FinWait2;
                if (receiving && (int)(edge - c->AdvertisedEdge) >= Mss)
                    SendAck(c);
                return n;
            }
            if (c->Reset)
                return Process.ErrBrokenPipe;
            bool more = c->State == TcpState.Established || c->State == TcpState.FinWait1 || c->State == TcpState.FinWait2
                        || c->State == TcpState.SynReceived;
            if (!more)
                return 0;   // the peer sent FIN: end of stream
            if (!Wait(c))
                return Process.ErrInterrupted;
        }
    }

    /// Half close: FIN after the queued data, but the handle stays usable for receiving.
    public static void Shutdown(int h)
    {
        lock (Stack.Lock) {
            TcpConnection* c = Get(h);
            if (c == null || (c->State != TcpState.Established && c->State != TcpState.CloseWait))
                return;
            c->FinQueued = true;
            Output(c);
        }
    }

    /// Closes our side (FIN after the queued data) and lets go of the handle; a listener stops listening.
    public static void Close(int h)
    {
        lock (Stack.Lock) {
            TcpConnection* c = Get(h);
            if (c == null || !c->Open)
                return;
            c->Open = false;
            if (c->State == TcpState.Listen) {
                for int i in 0..Connections {   // connections nobody accepted are reset
                    TcpConnection* x = &Table[i];
                    if (x->Used && x->Parent == h && !x->Accepted) {
                        if (x->State != TcpState.Closed)
                            Segment(x, x->SendNext, (byte)(Rst | Ack), 0, 0);
                        Free(x);
                    }
                }
                Free(c);
                return;
            }
            if (c->State == TcpState.Established || c->State == TcpState.CloseWait || c->State == TcpState.SynReceived) {
                c->FinQueued = true;
                if (c->State == TcpState.SynReceived)
                    c->State = TcpState.Established;
                Output(c);
            } else if (c->State == TcpState.Closed || c->State == TcpState.SynSent) {
                Free(c);
            }
            // FIN_WAIT/CLOSING/LAST_ACK/TIME_WAIT finish on their own; Tick or the last ACK frees the slot
        }
    }

    /// Ends every connection of process `pid` (it exited): reset, freed at once.
    public static void CloseOwnedBy(uint pid)
    {
        lock (Stack.Lock) {
            for int i in 0..Connections {
                TcpConnection* c = &Table[i];
                if (!c->Used || c->Owner != pid || pid == 0)
                    continue;
                if (c->State != TcpState.Closed && c->State != TcpState.Listen && c->State != TcpState.TimeWait)
                    Segment(c, c->SendNext, (byte)(Rst | Ack), 0, 0);
                Free(c);
            }
        }
    }
}
