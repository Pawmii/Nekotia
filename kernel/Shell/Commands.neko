// Shell commands. Add one: a name in `Names` (for help/Tab), a branch in Run, a method.
using System;
using Nekotia;
using Nekotia.Hal;
using Nekotia.IO;
using Nekotia.Mem;
using Nekotia.OS.Drivers;
using Nekotia.Processes;
using Nekotia.Threading;

namespace Nekotia.OS;

public static unsafe class Commands
{
    /// Space-separated, used by Tab completion.
    public const string Names = "help clear info ps lspci ifconfig ping arp dhcp netstat disks mount umount mkfs sync ls cd pwd cat mkdir rm mv write df run progs kill spawn mem vm pages alloc uptime echo sleep irq layout colors neko selftest panic crash reboot shutdown";

    public static void Run(byte* cmd, byte* args)
    {
        if (Is(cmd, "help")) Help();
        else if (Is(cmd, "clear")) Terminal.Clear();
        else if (Is(cmd, "info")) Info();
        else if (Is(cmd, "ps")) Ps();
        else if (Is(cmd, "lspci")) Lspci(args);
        else if (Is(cmd, "ifconfig")) Network.Ifconfig();
        else if (Is(cmd, "ping")) Network.Ping(args);
        else if (Is(cmd, "arp")) Network.ArpTable();
        else if (Is(cmd, "netstat")) Network.Netstat();
        else if (Is(cmd, "dhcp")) Network.RunDhcp();
        else if (Is(cmd, "disks")) Files.Disks();
        else if (Is(cmd, "mount")) Files.Mount(args);
        else if (Is(cmd, "umount")) Files.Unmount(args);
        else if (Is(cmd, "mkfs")) Files.MakeFileSystem(args);
        else if (Is(cmd, "sync")) Files.Sync();
        else if (Is(cmd, "ls")) Files.List(args);
        else if (Is(cmd, "cd")) Files.ChangeDirectory(args);
        else if (Is(cmd, "pwd")) Files.PrintDirectory();
        else if (Is(cmd, "cat")) Files.Cat(args);
        else if (Is(cmd, "mkdir")) Files.MakeDirectory(args);
        else if (Is(cmd, "rm")) Files.Remove(args);
        else if (Is(cmd, "mv")) Files.Move(args);
        else if (Is(cmd, "write")) Files.Write(args);
        else if (Is(cmd, "df")) Files.Usage();
        else if (Is(cmd, "run")) RunProgram(args);
        else if (Is(cmd, "progs")) Programs();
        else if (Is(cmd, "kill")) KillProcess(args);
        else if (Is(cmd, "spawn")) Spawn(args);
        else if (Is(cmd, "mem")) Mem();
        else if (Is(cmd, "vm")) Vm();
        else if (Is(cmd, "pages")) PageStats();
        else if (Is(cmd, "alloc")) Alloc(args);
        else if (Is(cmd, "uptime")) Uptime();
        else if (Is(cmd, "echo")) Echo(args);
        else if (Is(cmd, "sleep")) Sleep(args);
        else if (Is(cmd, "irq")) Irqs();
        else if (Is(cmd, "layout")) Layout();
        else if (Is(cmd, "colors")) Colors();
        else if (Is(cmd, "neko")) Neko();
        else if (Is(cmd, "selftest")) SelfTest.Run(true);
        else if (Is(cmd, "panic")) Debug.Panic("requested from the shell");
        else if (Is(cmd, "crash")) Crash(args);
        else if (Is(cmd, "reboot")) {
            Vfs.Sync();
            Power.Reboot();
        } else if (Is(cmd, "shutdown")) {
            Vfs.Sync();
            Power.Shutdown();
        }
        else if (HasProgram(cmd)) Execute(cmd, args);   // `hello a b` = `run hello a b`
        else {
            Terminal.Write(AnsiColor.BrightRed, "unknown command: ");
            Terminal.Write(cmd);
            Terminal.WriteLine("  (try `help`)");
        }
    }

    static bool Is(byte* cmd, string name) => Str.Equals(cmd, name);

    const int HelpColumn = 20;   // where descriptions start

    /// "  name   description", the description wrapped at word boundaries to the screen width and
    /// starting on its own line when the name does not fit the column.
    static void Line(string name, string description)
    {
        Terminal.Write("  ");
        Terminal.Write(AnsiColor.BrightCyan, name);
        int used = 2 + Utf8Chars(Str.Bytes(name), (int)Str.Length(name));
        if (used >= HelpColumn) {   // at least one space before the description
            Terminal.WriteLine();
            used = 0;
        }
        Pad(used, HelpColumn);
        int width = (int)Terminal.Columns() - HelpColumn - 1;
        if (width < 20)
            width = 20;
        byte* text = Str.Bytes(description);
        int column = 0;
        while (*text != 0) {
            byte* word = text;
            int length = 0;
            while (word[length] != 0 && word[length] != ' ')
                length++;
            int chars = Utf8Chars(word, length);
            if (column > 0 && column + 1 + chars > width) {
                Terminal.WriteLine();
                Pad(0, HelpColumn);
                column = 0;
            } else if (column > 0) {
                Terminal.WriteChar((byte)' ');
                column++;
            }
            for int i in 0..length { Terminal.WriteChar(word[i]); }
            column += chars;
            text = word + length;
            while (*text == ' ')
                text++;
        }
        Terminal.WriteLine();
    }

    static int Utf8Chars(byte* s, int length)
    {
        int n = 0;
        for int i in 0..length {
            if ((s[i] & 0xC0) != 0x80)
                n++;
        }
        return n;
    }

    static void Section(string title)
    {
        Terminal.WriteLine(AnsiColor.BrightWhite, title);
    }

    static void Help()
    {
        Section("Files:");
        Line("ls [PATH]", "list a directory");
        Line("cd [DIR] / pwd", "change / show the working directory");
        Line("cat FILE…", "print files");
        Line("write FILE TEXT", "replace FILE with TEXT and a newline");
        Line("mkdir DIR…", "create directories");
        Line("rm PATH…", "remove files and empty directories");
        Line("mv FROM TO", "rename, or move into a directory");
        Line("df", "file system usage: nodes, open files, heap and initrd bytes");
        Line("disks", "block devices: size, model, sectors read and written (each is also /dev/NAME)");
        Line("mount [DEV DIR]", "mount a FAT32 disk on an empty directory; without arguments: list mounts");
        Line("umount DIR", "unmount (writes everything out first)");
        Line("mkfs DEV [LABEL]", "format a disk as FAT32 — erases it");
        Line("sync", "write pending metadata of every volume and flush the disks");
        Section("Programs:");
        Line("progs", "user programs in /bin");
        Line("run PROG ARGS", "run a user program in ring 3 (or just type its name or path; `&` at the end: background)");
        Line("kill PID", "end a user process (Ctrl+C ends the one in the foreground)");
        Line("ps", "threads and processes: state, priority, CPU time, context switches");
        Line("spawn KIND", "start a demo kernel thread: spinner primes burn counter");
        Section("Network:");
        Line("ifconfig", "address, MAC, gateway, DNS and packet counters of eth0");
        Line("ping IP [N]", "ICMP echo, e.g. ping 10.0.2.2 (the QEMU gateway); programs: httpd, fetch, nc, host (in sh)");
        Line("arp", "ARP cache: who has which MAC");
        Line("dhcp", "ask for an address again");
        Line("netstat", "TCP connections and UDP sockets");
        Section("System:");
        Line("info", "system information");
        Line("lspci [-v]", "PCI devices (-v: BARs, IRQ, capabilities)");
        Line("mem", "memory, heap and page allocator statistics");
        Line("vm", "virtual memory layout and page tables");
        Line("pages", "buddy allocator: free blocks per order");
        Line("alloc MB", "allocate MB on the heap (it grows), touch and free it");
        Line("irq", "interrupt counters");
        Line("uptime", "time since boot");
        Line("sleep MS", "sleep for MS milliseconds (LAPIC timer)");
        Line("echo TEXT", "print TEXT");
        Line("layout", "switch keyboard layout EN/RU (also Alt+Shift)");
        Line("colors", "console palette");
        Line("neko", "draw the cat (any key to return)");
        Line("clear", "clear the screen (also Ctrl+L)");
        Line("reboot / shutdown", "restart / power off (QEMU)");
        Section("Testing:");
        Line("selftest", "run the kernel self tests");
        Line("panic", "stop screen: KERNEL_PANIC");
        Line("crash KIND", "stop screen: null div throw custom assert pf gp ud bp double-free stack nx wp deadlock relock");
        Terminal.WriteLine("Keys: ↑/↓ history, Tab completion, Ctrl+U erase line, Ctrl+C cancel.");
    }

    static void Info()
    {
        BootInfo* boot = Kernel.Info;
        Terminal.WriteLine($"Nekotia {Kernel.Version} — x86_64 kernel written in C#, transpiled to C++ by nekoc");
        Terminal.WriteLine($"cpu:        {SysInfo.CpuBrand()}");
        Terminal.WriteLine($"processors: {SysInfo.CpuCount()} (the boot CPU runs the kernel), TSC {SysInfo.CpuMhz()} MHz");
        Terminal.WriteLine($"memory:     {boot->UsableMemory:size} usable of {boot->TotalMemory:size}");
        Terminal.WriteLine($"screen:     {boot->Screen.Width}x{boot->Screen.Height}, console {Terminal.Columns()}x{Terminal.Rows()}");
        Terminal.Write("bootloader: ");
        Terminal.Write(boot->BootloaderName);
        Terminal.Write(" ");
        Terminal.Write(boot->BootloaderVersion);
        Terminal.Write("\ncmdline:    ");
        Terminal.Write(boot->CommandLine);
        Terminal.WriteLine();
        Terminal.Write("uptime:     ");
        Uptime();
    }

    static void Mem()
    {
        BootInfo* boot = Kernel.Info;
        ulong freePages = Pages.FreeCount();
        ulong totalPages = Pages.TotalCount();
        Terminal.WriteLine($"physical:   {boot->UsableMemory:size} usable, {boot->TotalMemory:size} RAM, {boot->MemoryMapEntries} map entries");
        Terminal.WriteLine($"pages:      {freePages} free of {totalPages} ({freePages * Pages.Size:size} free)");
        Terminal.WriteLine($"heap:       {Heap.UsedBytes():size} used, {Heap.FreeBytes():size} free of {Heap.TotalBytes():size}, {Heap.BlockCount()} blocks");
        Terminal.Write("heap check: ");
        if (Heap.Check())
            Terminal.WriteLine(AnsiColor.Green, "ok");
        else
            Terminal.WriteLine(AnsiColor.BrightRed, "CORRUPTED");
    }

    // ---------------------------------------------------------------- threads

    static void Ps()
    {
        ulong up = Time.UptimeMs();
        if (up == 0) up = 1;
        Terminal.WriteLine(AnsiColor.BrightCyan, "  ID  PID  NAME                 STATE     PRI    CPU    CPU ms   CPU%  SWITCHES  STACK  WAITS FOR");
        ThreadInfo info = default;
        for (uint i = 0; Thread.GetInfo(i, out info); i++) {
            Terminal.Write($"  {info.Id}");
            Pad(Digits(info.Id), 4);
            if (info.Pid != 0)
                Terminal.Write($"{info.Pid}");
            else
                Terminal.Write("-");
            Pad(info.Pid != 0 ? Digits(info.Pid) : 1, 5);
            Terminal.Write(info.Name);
            Pad((int)Str.Length(info.Name), 21);
            Terminal.Write(StateName(info.State));
            Pad((int)Str.Length(StateName(info.State)), 10);
            Terminal.Write(info.Priority == ThreadPriority.High ? "high   " : info.Priority == ThreadPriority.Normal ? "normal " : "low    ");
            Terminal.Write($"{info.Cpu}");
            Pad(Digits(info.Cpu), 3);
            Pad(Digits(info.CpuMs), 9);
            Terminal.Write($"{info.CpuMs}");
            double share = info.CpuMs * 100.0 / up;
            Pad(share >= 10 ? 4 : 3, 7);
            Terminal.Write($"{share:F1}");
            Pad(Digits(info.Switches), 10);
            Terminal.Write($"{info.Switches}");
            Pad(Digits(info.StackKib) + 4, 7);
            Terminal.Write($"{info.StackKib} KiB  ");
            Terminal.WriteLine(info.BlockedOn);
        }
        uint cpus = SysInfo.CpuCount();
        Terminal.WriteLine($"{Thread.Count()} threads on {cpus} CPU(s), {Thread.ContextSwitches()} context switches, idle {Thread.IdleMs() * 100.0 / (up * cpus):F1}%");

        if (Process.Count() == 0)
            return;
        Terminal.WriteLine(AnsiColor.BrightCyan, "  PID  PARENT  NAME                 STATE    THREADS  MEMORY     RUNNING FOR");
        ProcessInfo p = default;
        for (uint i = 0; Process.GetInfo(i, out p); i++) {
            Terminal.Write($"  {p.Pid}");
            Pad(Digits(p.Pid), 5);
            if (p.Parent != 0)
                Terminal.Write($"{p.Parent}");
            else
                Terminal.Write("kernel");
            Pad(p.Parent != 0 ? Digits(p.Parent) : 6, 8);
            Terminal.Write(p.Name);
            Pad((int)Str.Length(p.Name), 21);
            Terminal.Write(p.State == ProcessState.Running ? "running  " : "exited   ");
            Terminal.Write($"{p.Threads}");
            Pad(Digits(p.Threads), 9);
            Terminal.Write($"{p.MemoryKib} KiB");
            Pad(Digits(p.MemoryKib) + 4, 11);
            Terminal.WriteLine($"{p.UptimeMs} ms");
        }
    }

    // ---------------------------------------------------------------- PCI

    static void Lspci(byte* args)
    {
        bool verbose = Is(args, "-v");
        uint n = Pci.Count();
        if (n == 0) {
            Terminal.WriteLine("no PCI devices (host mode, or no configuration space access)");
            return;
        }
        PciDevice d = default;
        for (uint i = 0; Pci.GetInfo(i, out d); i++) {
            Hex(d.Bus, 2);
            Terminal.Write(":");
            Hex(d.Slot, 2);
            Terminal.Write(".");
            Terminal.WriteDec((ulong)d.Function);
            Terminal.Write("  ");
            Terminal.SetColor(AnsiColor.BrightCyan);
            Hex(d.VendorId, 4);
            Terminal.Write(":");
            Hex(d.DeviceId, 4);
            Terminal.ResetColor();
            Terminal.Write("  ");
            Terminal.Write(Pci.ClassName(d.Class, d.Subclass, d.ProgIf));
            string vendor = Pci.VendorName(d.VendorId);
            if (vendor != null) {
                Terminal.Write(AnsiColor.Gray, " — ");
                Terminal.Write(AnsiColor.Gray, vendor);
            }
            Terminal.WriteLine();
            if (verbose)
                LspciDetails(i, &d);
        }
        Terminal.WriteLine($"{n} device(s), configuration space through {(Pci.UsesEcam() ? "ECAM (ACPI MCFG)" : "ports 0xCF8/0xCFC")}");
    }

    static void LspciDetails(uint index, PciDevice* d)
    {
        Terminal.Write("          class ");
        Hex(d->Class, 2);
        Terminal.Write(".");
        Hex(d->Subclass, 2);
        Terminal.Write(".");
        Hex(d->ProgIf, 2);
        Terminal.Write($", rev {d->Revision}");
        if (d->IrqPin != 0)
            Terminal.Write($", INT{(char)('A' + d->IrqPin - 1)} → IRQ {d->IrqLine}");
        if (d->HeaderType == 1)
            Terminal.Write($", bridge to bus {Pci.Read8(index, 0x19)}");
        byte cap = Pci.Read8(index, 0x34);
        if ((Pci.Read16(index, 0x06) & 0x10) != 0 && cap >= 0x40) {
            Terminal.Write(", caps");
            for int guard in 0..48 {
                if (cap < 0x40)
                    break;
                byte id = Pci.Read8(index, cap);
                Terminal.Write(" ");
                Terminal.Write(id == Pci.CapMsi ? "MSI" : id == Pci.CapMsiX ? "MSI-X" : id == Pci.CapExpress ? "PCIe" : id == Pci.CapVendor ? "vendor" : id == 0x01 ? "PM" : id == 0x12 ? "SATA" : "?");
                cap = (byte)(Pci.Read8(index, (ushort)(cap + 1)) & 0xFC);
            }
        }
        Terminal.WriteLine();
        for int b in 0..6 {
            if (d->BarAddress[b] == 0 && d->BarSize[b] == 0)
                continue;
            Terminal.Write($"          BAR{b} ");
            bool io = (d->BarFlags[b] & Pci.BarIo) != 0;
            Terminal.Write(io ? "I/O " : (d->BarFlags[b] & Pci.Bar64) != 0 ? "mem64 " : "mem32 ");
            Terminal.Write($"{d->BarAddress[b]:X}  {d->BarSize[b]:size}");
            if ((d->BarFlags[b] & Pci.BarPrefetchable) != 0)
                Terminal.Write(", prefetchable");
            Terminal.WriteLine();
        }
    }

    static void Hex(ulong value, int digits)
    {
        for (int shift = (digits - 1) * 4; shift >= 0; shift -= 4) {
            int digit = (int)((value >> shift) & 0xF);
            Terminal.WriteChar((byte)(digit < 10 ? '0' + digit : 'a' + digit - 10));
        }
    }

    // ---------------------------------------------------------------- user programs

    /// A file in /bin called `name`, or `name` itself when it is a path (./prog, /tmp/prog).
    static bool HasProgram(byte* name)
    {
        bool path = false;
        for (byte* c = name; *c != 0; c++)
            path |= *c == '/';
        FileStat st = default;
        if (path)
            return Vfs.Stat(name, out st) == 0 && st.Type == NodeType.File;
        byte* full = stackalloc byte[Vfs.MaxPath];
        Files.Join("/bin", name, full);
        return Vfs.Stat(full, out st) == 0 && st.Type == NodeType.File;
    }

    static void Programs()
    {
        OpenFile* dir = null;
        if (Vfs.Open("/bin", Vfs.Read, out dir) < 0) {
            Terminal.WriteLine("no /bin directory");
            return;
        }
        DirEntry e = default;
        uint n = 0;
        for (uint i = 0; Vfs.ReadDirectory(dir, i, out e) == 1; i++) {
            if (e.Type != NodeType.File)
                continue;
            Terminal.Write("  ");
            Terminal.SetColor(AnsiColor.BrightCyan);
            Terminal.Write(e.Name);
            Terminal.ResetColor();
            Pad((int)Str.Length(e.Name), 14);
            Terminal.WriteLine($"{e.Size:size}");
            n++;
        }
        Vfs.Close(dir);
        if (n == 0)
            Terminal.WriteLine("no programs (host mode, or the boot medium has no initrd)");
        else
            Terminal.WriteLine($"{n} program(s) in /bin — run one with `run NAME ARGS` or just `NAME ARGS`");
    }

    static void KillProcess(byte* args)
    {
        uint pid = 0;
        int digits = 0;
        while (*args >= '0' && *args <= '9' && digits < 9) {
            pid = pid * 10 + (uint)(*args - '0');
            args++;
            digits++;
        }
        if (digits == 0 || *args != 0) {
            Terminal.WriteLine("usage: kill PID   (pids: ps)");
            return;
        }
        if (Process.Kill(pid) != 0)
            Terminal.WriteLine($"kill: no process {pid}");
    }

    static void RunProgram(byte* args)
    {
        if (*args == 0) {
            Terminal.WriteLine("usage: run PROGRAM [ARGS] [&]   (programs: `progs`; a path runs that file)");
            return;
        }
        byte* rest = args;
        while (*rest != 0 && *rest != ' ')
            rest++;
        if (*rest != 0) {
            *rest = 0;
            rest++;
        }
        Execute(args, rest);
    }

    /// Runs `name` in the foreground (the shell waits for it) or, with a trailing `&`, in the background.
    static void Execute(byte* name, byte* args)
    {
        bool background = false;
        int n = (int)Str.Length(args);
        while (n > 0 && args[n - 1] == ' ')
            n--;
        if (n > 0 && args[n - 1] == '&') {
            background = true;
            args[n - 1] = 0;
        }

        long pid = Process.Start(name, args, background);
        if (pid < 0) {
            Terminal.Write(AnsiColor.BrightRed, "run: ");
            Terminal.Write(name);
            Terminal.Write(": ");
            Terminal.WriteLine(Process.ErrorText(pid));
            return;
        }
        if (background) {
            Terminal.WriteLine($"[{pid}] running in the background");
            return;
        }
        long code = Process.Wait((uint)pid);
        if (code != 0) {
            Terminal.SetColor(AnsiColor.Gray);
            Terminal.Write("[");
            Terminal.Write(name);
            Terminal.Write($" exited with code {code}]");
            Terminal.ResetColor();
            Terminal.WriteLine();
        }
    }

    static string StateName(ThreadState state)
    {
        switch (state)
        {
            case ThreadState.Ready: return "ready";
            case ThreadState.Running: return "running";
            case ThreadState.Sleeping: return "sleeping";
            case ThreadState.Blocked: return "blocked";
            default: return "dead";
        }
    }

    static void Pad(int used, int width)
    {
        for int i in used..width { Terminal.WriteChar((byte)' '); }
    }

    static void Spawn(byte* kind)
    {
        uint id = 0;
        if (Is(kind, "spinner")) id = Thread.Start("spinner", &Demos.Spinner, 200);
        else if (Is(kind, "primes")) id = Thread.Start("primes", &Demos.Primes, 3000000, ThreadPriority.Low);
        else if (Is(kind, "burn")) id = Thread.Start("burn", &Demos.Burn, 5000, ThreadPriority.Low);
        else if (Is(kind, "counter")) id = Thread.Start("counter", &Demos.Counter, 5);
        else {
            Terminal.WriteLine("usage: spawn spinner|primes|burn|counter");
            return;
        }
        Terminal.WriteLine($"started thread #{id} — try `ps`");
    }

    static void Vm()
    {
        unless (VirtualMemory.Ready()) {
            Terminal.WriteLine("no page tables in host mode");
            return;
        }
        VmStats vm = VmStats.Get();
        Terminal.WriteLine($"paging:     own 4-level tables, {vm.TablePages} table pages, NX {(vm.NoExecute ? "on" : "off")}, framebuffer {(vm.WriteCombining ? "write-combining" : "uncached")}");
        Terminal.WriteLine($"kernel:     0xffffffff80000000 → phys {vm.KernelPhysical:X}: text {vm.TextBytes:size} RX, rodata {vm.RodataBytes:size} R, data {vm.DataBytes:size} RW");
        Terminal.WriteLine($"hhdm:       {Kernel.Info->HhdmOffset:X}  all RAM, read/write, no execute");
        Terminal.WriteLine($"heap:       {VirtualMemory.HeapBase:X}  {vm.HeapMapped:size} mapped, {Heap.UsedBytes():size} used — grows on demand");
        Terminal.WriteLine($"free:       {VirtualMemory.FreeBase:X}  for VirtualMemory.Map");
        Terminal.WriteLine($"stacks:     {VirtualMemory.StackBase:X}  {vm.Stacks} stack(s), each above an unmapped guard page");
    }

    static void PageStats()
    {
        Terminal.WriteLine("order  block      free blocks");
        for uint order in 0..=10 {
            ulong blocks = Pages.FreeBlocks(order);
            Terminal.Write($"  {order}");
            Terminal.Write(order < 10 ? "    " : "   ");
            ulong size = Pages.Size << (int)order;
            ulong shown = size >= 1024 * 1024 ? size / (1024 * 1024) : size / 1024;
            Terminal.Write($"{size:size}");
            for int i in (Digits(shown) + 4)..11 { Terminal.WriteChar((byte)' '); }
            Terminal.WriteLine($"{blocks}");
        }
        Terminal.WriteLine($"free: {Pages.FreeCount()} of {Pages.TotalCount()} pages, largest block order {Pages.LargestFreeOrder()}");
    }

    static int Digits(ulong v)
    {
        int n = 1;
        while (v >= 10) {
            v /= 10;
            n++;
        }
        return n;
    }

    static void Alloc(byte* args)
    {
        ulong mb = 0;
        unless (ParseNumber(args, out mb) && mb > 0) {
            Terminal.WriteLine("usage: alloc MB");
            return;
        }
        nuint size = (nuint)(mb * 1024 * 1024);
        nuint before = Heap.TotalBytes();
        ulong start = Time.UptimeMs();
        byte* block = (byte*)Heap.Alloc(size);
        if (block == null) {
            Terminal.WriteLine(AnsiColor.BrightRed, "allocation failed: out of memory");
            return;
        }
        defer Heap.Free(block);
        Memory.Set(block, 0xA5, size);
        Terminal.WriteLine($"allocated {size:size} at {(ulong)block:X} in {Time.UptimeMs() - start} ms; heap {before:size} → {Heap.TotalBytes():size}");
    }

    static void Uptime()
    {
        ulong ms = Time.UptimeMs();
        ulong seconds = ms / 1000;
        ulong minutes = seconds / 60;
        ulong hours = minutes / 60;
        Terminal.Write($"{hours}h ");
        Pad2(minutes % 60);
        Terminal.Write("m ");
        Pad2(seconds % 60);
        Terminal.Write(".");
        ulong frac = ms % 1000;
        if (frac < 100) Terminal.WriteChar((byte)'0');
        if (frac < 10) Terminal.WriteChar((byte)'0');
        Terminal.WriteLine($"{frac}s");
    }

    static void Pad2(ulong v)
    {
        if (v < 10)
            Terminal.WriteChar((byte)'0');
        Terminal.WriteDec(v);
    }

    static void Echo(byte* args)
    {
        Terminal.Write(args);
        Terminal.WriteLine();
    }

    static void Sleep(byte* args)
    {
        ulong ms = 0;
        unless (ParseNumber(args, out ms)) {
            Terminal.WriteLine("usage: sleep MS");
            return;
        }
        ulong start = Time.UptimeMs();
        Time.Sleep(ms);
        Terminal.WriteLine($"slept {Time.UptimeMs() - start} ms");
    }

    static void Irqs()
    {
        Terminal.WriteLine($"timer:      {Time.UptimeMs()} ticks at {Time.TimerHz()} Hz (LAPIC, vector 0x20)");
        Terminal.WriteLine($"keyboard:   {Irq.Count(1)} interrupts (IRQ 1 → IOAPIC → vector 0x31), {Keyboard.DroppedKeys} keys dropped");
        byte vector = 0;
        string name = null;
        ulong count = 0;
        for (uint i = 0; Irq.GetMsi(i, out vector, out name, out count); i++) {
            Terminal.Write(name);
            Terminal.Write(":");
            Pad((int)Str.Length(name) + 1, 12);
            Terminal.WriteLine($"{count} interrupts (MSI-X → vector {(ulong)vector:X})");
        }
    }

    static void Layout()
    {
        Keyboard.ToggleLayout();
        Terminal.WriteLine(Keyboard.Russian ? "layout: русская (ЙЦУКЕН)" : "layout: English (QWERTY)");
    }

    static void Colors()
    {
        for int i in 0..16 {
            Terminal.SetColor((AnsiColor)i);
            Terminal.Write("██");
            if (i == 7) {
                Terminal.ResetColor();
                Terminal.WriteLine("  normal");
            }
        }
        Terminal.ResetColor();
        Terminal.WriteLine("  bright");
    }

    static void Neko()
    {
        unless (Graphics.DrawSplash(&Kernel.Info->Screen)) {
            Terminal.WriteLine("no framebuffer");
            return;
        }
        Keyboard.ReadKey();
        Terminal.Redraw();
    }

    // A value the optimizer cannot see through, so the crashes below really happen at run time.
    static ulong _zero;

    static void Crash(byte* kind)
    {
        if (Is(kind, "null")) {
            Node* node = (Node*)_zero;
            node->Value = 42;                                   // #PF near 0 → NullReferenceException
        } else if (Is(kind, "div")) {
            int divisor = (int)_zero;
            Terminal.WriteDec(100 / divisor);                   // #DE → DivideByZeroException
        } else if (Is(kind, "throw")) {
            throw new InvalidOperationException("the shell asked for an unhandled exception");
        } else if (Is(kind, "custom")) {
            throw new KernelError("a kernel-defined exception type");
        } else if (Is(kind, "assert")) {
            Debug.Assert(Heap.BlockCount() == 0, "the heap should have no blocks (it always has some)");
        } else if (Is(kind, "pf")) {
            *(ulong*)0xDEAD0000 = 42;                           // #PF on an unmapped page
        } else if (Is(kind, "gp")) {
            *(ulong*)(0x8000000000000000 | _zero) = 1;          // non-canonical address → #GP
        } else if (Is(kind, "ud")) {
            asm "ud2";                                          // #UD
        } else if (Is(kind, "bp")) {
            Intrinsics.Breakpoint();                            // #BP (int3)
        } else if (Is(kind, "stack")) {
            Terminal.WriteDec(Recurse(0));                      // guard page → StackOverflowException
        } else if (Is(kind, "nx")) {
            byte* code = (byte*)Heap.Alloc(16);
            code[0] = 0xC3;                                     // ret — but the heap is not executable
            delegate*<void> function = (delegate*<void>)code;
            function();
        } else if (Is(kind, "wp")) {
            delegate*<void> help = &Help;
            *(byte*)help = 0x90;                                // kernel code is read-only
        } else if (Is(kind, "deadlock")) {
            Demos.StartDeadlock();
            Thread.Sleep(1000);                                 // the second lock() detects the cycle
        } else if (Is(kind, "relock")) {
            Demos.Relock();
        } else if (Is(kind, "double-free")) {
            void* block = Heap.Alloc(64);
            Heap.Free(block);
            Heap.Free(block);                                   // HEAP_CORRUPTION
        } else {
            Terminal.WriteLine("usage: crash null|div|throw|custom|assert|pf|gp|ud|bp|double-free|stack|nx|wp|deadlock|relock");
        }
    }

    static int Recurse(int depth)
    {
        if (_zero == 1)
            return depth;   // never true; keeps the recursion "finite" for the compiler
        byte* frame = stackalloc byte[256];
        frame[0] = (byte)depth;
        return Recurse(depth + 1) + frame[0];
    }

    static bool ParseNumber(byte* s, out ulong value)
    {
        value = 0;
        if (s == null || *s < '0' || *s > '9')
            return false;
        while (*s >= '0' && *s <= '9') {
            value = value * 10 + (ulong)(*s - '0');
            s++;
        }
        return *s == 0 || *s == ' ';
    }
}
