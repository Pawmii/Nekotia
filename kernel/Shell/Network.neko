// Network commands of the kernel shell: ifconfig, ping, arp, dhcp.
using Nekotia;
using Nekotia.Hal;
using Nekotia.Net;
using Nekotia.OS.Net;
using Nekotia.Processes;
using Nekotia.Threading;

namespace Nekotia.OS;

public static unsafe class Network
{
    static bool Ready()
    {
        if (Stack.Up)
            return true;
        Terminal.WriteLine("no network interface (QEMU: -netdev user,id=n0 -device virtio-net-pci,netdev=n0 — `make run` adds it)");
        return false;
    }

    public static void Ifconfig()
    {
        if (!Ready())
            return;
        NetInfo info = default;
        NetDevice.GetInfo(Stack.Device, out info);
        Terminal.SetColor(AnsiColor.BrightCyan);
        Terminal.Write(info.Name);
        Terminal.ResetColor();
        Terminal.Write("  MAC ");
        Stack.WriteMac(Stack.Mac);
        Terminal.WriteLine($"  MTU {info.Mtu}");
        if (Stack.Configured) {
            Terminal.Write("      inet ");
            Stack.WriteIp(Stack.Address);
            Terminal.Write("  netmask ");
            Stack.WriteIp(Stack.Netmask);
            Terminal.Write("  gateway ");
            Stack.WriteIp(Stack.Gateway);
            Terminal.Write("  dns ");
            Stack.WriteIp(Stack.Dns);
            Terminal.WriteLine();
            Terminal.Write("      DHCP server ");
            Stack.WriteIp(Nekotia.OS.Net.Dhcp.Server);
            Terminal.WriteLine($", lease {Nekotia.OS.Net.Dhcp.LeaseSeconds} s");
        } else {
            Terminal.WriteLine("      no address (try `dhcp`)");
        }
        Terminal.WriteLine($"      RX {info.RxPackets} packets {info.RxBytes:size}, dropped {info.RxDropped}   TX {info.TxPackets} packets {info.TxBytes:size}");
        Terminal.WriteLine($"      IPv4 in {Ip.Received} out {Ip.Sent} bad {Ip.Bad}; pings answered {Icmp.EchoesAnswered}; UDP without a listener {Udp.NoListener}");
    }

    public static void RunDhcp()
    {
        if (!Ready())
            return;
        Terminal.Write("dhcp: asking… ");
        if (!Nekotia.OS.Net.Dhcp.Configure()) {
            Terminal.WriteLine(AnsiColor.BrightRed, "no answer");
            return;
        }
        Terminal.Write("got ");
        Stack.WriteIp(Stack.Address);
        Terminal.Write(" via ");
        Stack.WriteIp(Stack.Gateway);
        Terminal.WriteLine();
    }

    static string StateName(TcpState s)
    {
        switch (s)
        {
            case TcpState.Listen: return "LISTEN";
            case TcpState.SynSent: return "SYN_SENT";
            case TcpState.SynReceived: return "SYN_RECEIVED";
            case TcpState.Established: return "ESTABLISHED";
            case TcpState.FinWait1: return "FIN_WAIT_1";
            case TcpState.FinWait2: return "FIN_WAIT_2";
            case TcpState.CloseWait: return "CLOSE_WAIT";
            case TcpState.Closing: return "CLOSING";
            case TcpState.LastAck: return "LAST_ACK";
            case TcpState.TimeWait: return "TIME_WAIT";
            default: return "CLOSED";
        }
    }

    static void Endpoint(uint ip, ushort port, bool any)
    {
        int used = 0;
        if (any) {
            Terminal.Write("*");
            used = 1;
        } else {
            Stack.WriteIp(ip);
            used = 7;
            for (uint v = ip; v != 0; v >>= 8) {
                uint b = v & 255;
                used += b >= 100 ? 2 : b >= 10 ? 1 : 0;
            }
        }
        Terminal.Write($":{port}");
        used += port >= 10000 ? 6 : port >= 1000 ? 5 : port >= 100 ? 4 : port >= 10 ? 3 : 2;
        for int i in used..24 { Terminal.WriteChar((byte)' '); }
    }

    public static void Netstat()
    {
        if (!Ready())
            return;
        Terminal.WriteLine(AnsiColor.BrightCyan, "PROTO  LOCAL                   REMOTE                  STATE         OWNER  QUEUED IN/OUT");
        lock (Stack.Lock) {
            for int i in 0..Tcp.Connections {
                TcpConnection* c = &Tcp.Table[i];
                if (!c->Used)
                    continue;
                Terminal.Write("tcp    ");
                Endpoint(c->LocalIp, c->LocalPort, c->State == TcpState.Listen);
                Endpoint(c->RemoteIp, c->RemotePort, c->State == TcpState.Listen);
                string name = StateName(c->State);
                Terminal.Write(name);
                for int p in (int)Str.Length(name)..14 { Terminal.WriteChar((byte)' '); }
                if (c->Owner == 0)
                    Terminal.Write("kernel ");
                else
                    Terminal.Write($"pid {c->Owner}  ");
                Terminal.WriteLine($"{c->ReceiveCount}/{c->SendCount}");
            }
            for int i in 0..Udp.Sockets {
                UdpSocket* s = &Udp.Table[i];
                if (!s->Used)
                    continue;
                Terminal.Write("udp    ");
                Endpoint(0, s->Port, true);
                Terminal.Write("*                       ");
                Terminal.Write("              ");
                if (s->Owner == 0)
                    Terminal.Write("kernel ");
                else
                    Terminal.Write($"pid {s->Owner}  ");
                Terminal.WriteLine($"{s->Count} datagram(s)");
            }
        }
        Terminal.WriteLine($"TCP: {Tcp.Retransmits} retransmits ({Tcp.FastRetransmits} fast), {Tcp.OutOfOrderKept} out-of-order segments kept, {Tcp.ResetsSent} resets sent");
        Terminal.WriteLine($"ICMP: {Icmp.UnreachablesSent} port-unreachable sent, {Icmp.UnreachablesReceived} received");
    }

    public static void ArpTable()
    {
        if (!Ready())
            return;
        uint n = 0;
        lock (Stack.Lock) {
            for int i in 0..Arp.Size {
                ArpEntry* e = &Arp.Table[i];
                if (!e->Valid)
                    continue;
                Terminal.Write("  ");
                Stack.WriteIp(e->Ip);
                Terminal.Write("  ");
                Stack.WriteMac(e->Mac);
                Terminal.WriteLine($"  {(Time.UptimeMs() - e->SeenMs) / 1000} s ago");
                n++;
            }
        }
        if (n == 0)
            Terminal.WriteLine("ARP cache is empty");
    }

    public static void Ping(byte* args)
    {
        if (!Ready())
            return;
        uint ip = 0;
        if (!Stack.ParseIp(args, out ip)) {
            Terminal.WriteLine("usage: ping A.B.C.D [COUNT]   (e.g. ping 10.0.2.2 — the QEMU gateway)");
            return;
        }
        byte* rest = args;
        while (*rest != 0 && *rest != ' ')
            rest++;
        while (*rest == ' ')
            rest++;
        int count = 4;
        if (*rest >= '1' && *rest <= '9') {
            count = 0;
            while (*rest >= '0' && *rest <= '9')
                count = count * 10 + (*rest++ - '0');
        }
        byte* mac = stackalloc byte[6];
        if (!Stack.IsLocal(ip) && !Arp.Resolve(ip, mac)) {
            Terminal.Write(AnsiColor.BrightRed, "ping: ");
            Stack.WriteIp(Stack.NextHop(ip));
            Terminal.WriteLine(AnsiColor.BrightRed, " does not answer ARP");
            return;
        }
        uint received = 0;
        ulong mhz = SysInfo.CpuMhz();
        if (mhz == 0)
            mhz = 1000;
        for int seq in 1..=count {
            ulong start = Cpu.ReadTimestamp();
            Icmp.SendEcho(ip, (ushort)seq, 56);
            byte ttl = 0;
            int bytes = 0;
            if (Icmp.WaitReply((ushort)seq, 1000, out ttl, out bytes)) {
                ulong us = (Cpu.ReadTimestamp() - start) / mhz;
                Terminal.Write($"{bytes} bytes from ");
                Stack.WriteIp(ip);
                Terminal.WriteLine($": icmp_seq={seq} ttl={ttl} time={us / 1000}.{(us % 1000) / 100} ms");
                received++;
            } else {
                Terminal.SetColor(AnsiColor.Yellow);
                Terminal.WriteLine($"icmp_seq={seq}: no reply");
                Terminal.ResetColor();
            }
            if (seq < count) {
                ulong ms = (Cpu.ReadTimestamp() - start) / mhz / 1000;
                if (ms < 1000)
                    Thread.Sleep(1000 - ms);
            }
        }
        Terminal.WriteLine($"{count} sent, {received} received, {(count - received) * 100 / count}% loss");
    }
}
