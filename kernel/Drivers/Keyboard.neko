// PS/2 keyboard driver (scancode set 1, as delivered by the i8042 with translation on).
// IRQ 1 → OnInterrupt → key events in a lock-free ring buffer → ReadKey() in the shell.
// Layouts: English (QWERTY) and Russian (ЙЦУКЕН), switched with Alt+Shift.
using Nekotia;
using Nekotia.Hal;
using Nekotia.Processes;
using Nekotia.Threading;

namespace Nekotia.OS.Drivers;

/// Special keys live above the Unicode range; printable keys are plain codepoints,
/// Ctrl+A…Ctrl+Z are ASCII control codes 1…26 (Ctrl+C = 3, Ctrl+L = 12, Ctrl+U = 21).
public enum Key : uint
{
    None = 0,
    Up = 0x110000, Down, Left, Right, Home, End, PageUp, PageDown, Insert, Delete,
    F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12,
}

public unsafe struct KeyRing
{
    public fixed uint Items[128];
}

public static unsafe class Keyboard
{
    const ushort DataPort = 0x60;
    const ushort StatusPort = 0x64;
    const int RingSize = 128;

    // Scancode set 1 make codes 0x00…0x39 → characters. \0 = no character (modifiers etc.).
    const string EnNormal  = "\0\x1b" + "1234567890-=" + "\b\t" + "qwertyuiop[]" + "\n\0" + "asdfghjkl;'`" + "\0\\" + "zxcvbnm,./" + "\0*\0 ";
    const string EnShifted = "\0\x1b" + "!@#$%^&*()_+" + "\b\t" + "QWERTYUIOP{}" + "\n\0" + "ASDFGHJKL:\"~" + "\0|"  + "ZXCVBNM<>?" + "\0*\0 ";
    const string RuNormal  = "\0\x1b" + "1234567890-=" + "\b\t" + "йцукенгшщзхъ" + "\n\0" + "фывапролджэё" + "\0\\" + "ячсмитьбю." + "\0*\0 ";
    const string RuShifted = "\0\x1b" + "!\"№;%:?*()_+" + "\b\t" + "ЙЦУКЕНГШЩЗХЪ" + "\n\0" + "ФЫВАПРОЛДЖЭЁ" + "\0/"  + "ЯЧСМИТЬБЮ," + "\0*\0 ";

    static KeyRing _ring;
    static Semaphore _available;   // one unit per queued key; ReadKey sleeps on it
    static volatile int _head;   // next slot to read (main code)
    static volatile int _tail;   // next slot to write (interrupt)
    static ulong _dropped;

    static bool _leftShift, _rightShift, _ctrl, _alt, _capsLock, _extended;
    static bool _russian;

    public static bool Russian => _russian;
    public static ulong DroppedKeys => _dropped;

    /// Drains whatever the controller buffered before the driver was ready.
    public static void Init()
    {
        Usb.SetKeyboardSink(&Feed);   // USB keyboards arrive as the same scancodes
        for int i in 0..64 {
            if ((Port.In8(StatusPort) & 1) == 0)
                break;
            Port.In8(DataPort);
        }
    }

    /// A scancode from a USB keyboard (xHCI interrupt handler: also interrupt context).
    static void Feed(byte scancode) => Handle(scancode);

    @irq(1)
    static void OnInterrupt() => I8042.Drain();

    /// A byte from the PS/2 keyboard port (I8042.Drain, interrupt context).
    public static void Scancode(byte scancode) => Handle(scancode);

    public static bool TryReadKey(out uint key)
    {
        key = 0;
        if (_head == _tail)
            return false;
        key = _ring.Items[_head];
        _head = (_head + 1) % RingSize;
        return true;
    }

    /// Blocks the calling thread until a key is pressed (other threads keep running).
    public static uint ReadKey()
    {
        uint key = 0;
        loop {
            _available.Wait();
            if (TryReadKey(out key))
                return key;
        }
    }

    /// Like ReadKey, but returns 0 when the calling thread is being killed (reads on behalf of a user program).
    public static uint ReadKeyInterruptible()
    {
        uint key = 0;
        loop {
            unless (_available.WaitInterruptible())
                return 0;
            if (TryReadKey(out key))
                return key;
        }
    }

    public static void ToggleLayout() => _russian = !_russian;

    // ---------------------------------------------------------------- decoding (runs in the IRQ handler)

    static void Push(uint key)
    {
        int next = (_tail + 1) % RingSize;
        if (next == _head) {
            _dropped++;
            return;
        }
        _ring.Items[_tail] = key;
        Intrinsics.CompilerBarrier();
        _tail = next;
        _available.Signal();   // wakes ReadKey (allowed from an interrupt handler)
    }

    /// One scancode. While a display server reads /dev/input every press and release goes there as an event
    /// (with the character the layout gives); otherwise presses become console keys.
    static void Handle(byte scancode)
    {
        if (scancode == 0xE0) {
            _extended = true;
            return;
        }
        bool released = (scancode & 0x80) != 0;
        byte code = (byte)(scancode & 0x7F);
        bool extended = _extended;
        _extended = false;

        uint key = extended ? DecodeExtended(code, released) : Decode(code, released);
        if (Input.Grabbed()) {
            if (!released && code == 0x0E && _ctrl && _alt) {
                Input.Zap();   // Ctrl+Alt+Backspace: end the display server, the console comes back
                return;
            }
            if (!released && code == 0x58 && _ctrl && _alt) {
                DumpThreads();   // Ctrl+Alt+F12: what every thread is doing, on the serial port (debugging)
                return;
            }
            Input.Key((ushort)(extended ? 0x100 | code : code), !released, Mods(), released ? 0 : key);
            return;
        }
        if (released || key == 0)
            return;
        // Ctrl+C while a program owns the console ends it (exit code 130) instead of reaching anyone.
        if (key == 3 && _ctrl && Process.InterruptForeground()) {
            Terminal.WriteLine(AnsiColor.BrightRed, "^C");
            return;
        }
        Push(key);
    }

    static void DumpThreads()
    {
        Serial.WriteLine("threads (Ctrl+Alt+F12):");
        ThreadInfo info = default;
        for (uint i = 0; Thread.GetInfo(i, out info); i++) {
            Serial.Write($"  {info.Id} pid {info.Pid} ");
            Serial.Write(info.Name);
            Serial.Write($" state {(int)info.State} cpu_ms {info.CpuMs} switches {info.Switches} ");
            Serial.Write(info.BlockedOn);
            Serial.WriteLine("");
        }
    }

    static byte Mods()
    {
        byte m = 0;
        if (_leftShift || _rightShift) m |= Input.ModShift;
        if (_ctrl) m |= Input.ModCtrl;
        if (_alt) m |= Input.ModAlt;
        if (_capsLock) m |= Input.ModCaps;
        return m;
    }

    /// Updates the modifiers; returns the key a press stands for (a codepoint, a control code or a Key), 0 for none.
    static uint Decode(byte code, bool released)
    {
        switch (code)
        {
            case 0x2A:
                SetShift(ref _leftShift, released);
                return 0;
            case 0x36:
                SetShift(ref _rightShift, released);
                return 0;
            case 0x1D:
                _ctrl = !released;
                return 0;
            case 0x38:
                SetAlt(released);
                return 0;
        }
        if (released)
            return 0;   // releases carry no character (events still report them)

        if (code == 0x3A) {
            _capsLock = !_capsLock;
            return 0;
        }
        if (code >= 0x3B && code <= 0x44)
            return (uint)Key.F1 + (uint)(code - 0x3B);
        if (code == 0x57 || code == 0x58)
            return code == 0x57 ? (uint)Key.F11 : (uint)Key.F12;
        if (code >= EnNormal.Length)
            return 0;

        uint plain = _russian ? RuNormal[code] : EnNormal[code];
        if (plain == 0)
            return 0;

        if (_ctrl) {
            unless (IsLatinKey(code))
                return 0;
            return (uint)(EnNormal[code] - 'a' + 1);   // Ctrl+letter → control code, in any layout
        }

        bool shift = _leftShift || _rightShift;
        if (_capsLock && IsLetter(plain))
            shift = !shift;
        return shift ? (_russian ? RuShifted[code] : EnShifted[code]) : plain;
    }

    static uint DecodeExtended(byte code, bool released)
    {
        switch (code)
        {
            case 0x1D:
                _ctrl = !released;
                return 0;
            case 0x38:
                SetAlt(released);
                return 0;
        }
        if (released)
            return 0;
        return code switch
        {
            0x48 => (uint)Key.Up,
            0x50 => (uint)Key.Down,
            0x4B => (uint)Key.Left,
            0x4D => (uint)Key.Right,
            0x47 => (uint)Key.Home,
            0x4F => (uint)Key.End,
            0x49 => (uint)Key.PageUp,
            0x51 => (uint)Key.PageDown,
            0x52 => (uint)Key.Insert,
            0x53 => (uint)Key.Delete,
            0x1C => '\n',   // keypad Enter
            0x35 => '/',    // keypad /
            _ => 0,
        };
    }

    static void SetShift(ref bool shift, bool released)
    {
        if (!released && !shift && _alt)
            ToggleLayout();
        shift = !released;
    }

    static void SetAlt(bool released)
    {
        if (!released && !_alt && (_leftShift || _rightShift))
            ToggleLayout();
        _alt = !released;
    }

    static bool IsLatinKey(byte code) => code < EnNormal.Length && EnNormal[code] >= 'a' && EnNormal[code] <= 'z';

    static bool IsLetter(uint c) =>
        c >= 'a' && c <= 'z' || c >= 0x430 && c <= 0x44F || c == 0x451;   // latin, а…я, ё
}
