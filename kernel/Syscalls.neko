// The console's input side, and system calls written in C#. The runtime (runtime/src/core/process.cpp)
// handles the basic system calls itself — exit, read/write, files, spawn, wait, alloc… — and routes every
// number registered with @syscall (32 and above) here. Handlers run on the calling program's own thread,
// in kernel mode, with interrupts enabled.
using Nekotia;
using Nekotia.Hal;
using Nekotia.IO;
using Nekotia.Mem;
using Nekotia.Processes;
using Nekotia.OS.Drivers;
using Nekotia.Threading;

namespace Nekotia.OS;

public unsafe struct ReadBuffer
{
    public fixed byte Bytes[1024];   // UTF-8 of the line being returned to the program
    public fixed byte Widths[256];   // bytes per typed character, for Backspace
}

public static unsafe class Syscalls
{
    const int MaxChars = 250;

    static ReadBuffer _line;
    static int _length;     // bytes in _line
    static int _position;   // next byte read() hands out
    static Mutex _reading;  // one program reads the keyboard at a time

    /// Hooks the keyboard up to reads of /dev/console (fd 0 of programs the kernel starts).
    public static void Init() => Vfs.SetConsoleReader(&ConsoleRead);

    /// Reads of /dev/console, cooked like a terminal: the program gets whole lines (with the final '\n') once
    /// Enter is pressed, the user can correct them with Backspace, and Ctrl+D on an empty line is end of input
    /// (0 bytes). Ctrl+C never gets here: the keyboard driver kills the foreground program, and the interrupted
    /// wait makes read return. `buffer` is kernel memory (the runtime copies it out to the program).
    static long ConsoleRead(byte* buffer, ulong length)
    {
        if (length == 0)
            return 0;

        long n = 0;
        lock (_reading) {
            if (_position == _length && !ReadLine())
                return Process.ErrInterrupted;   // the program is being killed
            n = _length - _position;
            if ((ulong)n > length)
                n = (long)length;
            fixed (byte* bytes = _line.Bytes) {
                Memory.Copy(buffer, bytes + _position, (nuint)n);
            }
            _position += (int)n;
        }
        return n;
    }

    /// False when the reading program is killed meanwhile (the partial line is dropped).
    static bool ReadLine()
    {
        _length = 0;
        _position = 0;
        int chars = 0;
        loop {
            uint key = Keyboard.ReadKeyInterruptible();
            if (key == 0) {
                _length = 0;
                return false;
            }
            if (key == '\n') {
                Terminal.WriteChar((byte)'\n');
                _line.Bytes[_length++] = (byte)'\n';
                return true;
            }
            if (key == 4 && chars == 0)
                return true;   // Ctrl+D: end of input (0 bytes)
            if (key == '\b') {
                if (chars > 0) {
                    chars--;
                    _length -= _line.Widths[chars];
                    Terminal.Write("\b \b");
                }
                continue;
            }
            if (key < 0x20 || key >= 0x110000 || chars == MaxChars)
                continue;   // other control keys, arrows, F-keys
            byte* utf8 = stackalloc byte[4];
            int width = Shell.EncodeUtf8(key, utf8);
            for int i in 0..width {
                _line.Bytes[_length++] = utf8[i];
            }
            _line.Widths[chars++] = (byte)width;
            Terminal.WriteCodepoint(key);
        }
    }
}
