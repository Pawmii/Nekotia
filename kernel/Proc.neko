// /proc: text files generated by C# at the moment they are read (vfs::create_generated).
//
//   /proc/version  uptime  cmdline  cpuinfo  meminfo  processes  threads  mounts  disks  pci
//   /proc/net/dev  /proc/net/arp  /proc/net/tcp  /proc/net/udp
//
// `cat /proc/meminfo`, `grep tcp /proc/net/tcp`, `httpd` serving /proc — they are ordinary files to programs.
using Nekotia;
using Nekotia.Hal;
using Nekotia.IO;
using Nekotia.Mem;
using Nekotia.Net;
using Nekotia.OS.Drivers;
using Nekotia.OS.Net;
using Nekotia.Processes;
using Nekotia.Threading;

namespace Nekotia.OS;

public static unsafe class Proc
{
    public static void Init()
    {
        Vfs.CreateDirectory("/proc");
        Vfs.CreateDirectory("/proc/net");
        Add("/proc/version", &Version);
        Add("/proc/uptime", &Uptime);
        Add("/proc/cmdline", &CommandLine);
        Add("/proc/cpuinfo", &CpuInfo);
        Add("/proc/meminfo", &MemInfo);
        Add("/proc/processes", &Processes);
        Add("/proc/threads", &Threads);
        Add("/proc/mounts", &Mounts);
        Add("/proc/disks", &Disks);
        Add("/proc/pci", &PciDevices);
        Add("/proc/net/dev", &NetDev);
        Add("/proc/net/arp", &NetArp);
        Add("/proc/net/tcp", &NetTcp);
        Add("/proc/net/udp", &NetUdp);
        Add("/proc/log", &KernelLog);
        Add("/proc/stat", &Stat);
        Add("/proc/display", &DisplayState);
    }

    /// Counters for monitors: `idle_ms` summed over every CPU (busy % = 1 - Δidle / (Δuptime × cpus)).
    static long Stat(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        t.WriteLine($"cpus {SysInfo.CpuCount()}");
        t.WriteLine($"uptime_ms {Time.UptimeMs()}");
        t.WriteLine($"idle_ms {Thread.IdleMs()}");
        t.WriteLine($"context_switches {Thread.ContextSwitches()}");
        t.WriteLine($"threads {Thread.Count()}");
        t.WriteLine($"processes {Process.Count()}");
        return t.Length;
    }

    /// Displays and who draws on them; the input grab.
    static long DisplayState(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        DisplayInfo d = default;
        for (uint i = 0; Displays.GetInfo(i, out d); i++) {
            t.WriteLine($"fb{i} {d.Width}x{d.Height} {d.Bpp}bpp pitch {d.Pitch} driver {d.Driver} owner {d.Owner}");
        }
        InputStats s = Input.Stats();
        t.WriteLine($"input events {s.Events} dropped {s.Dropped} grabbed_by {s.GrabbedBy}");
        t.WriteLine($"ps2 interrupts {I8042.Interrupts} rescued {I8042.Rescued} mouse bytes {Mouse.Bytes} packets {Mouse.Packets}");
        return t.Length;
    }

    static void Add(string path, delegate*<byte*, ulong, long> generate) => Vfs.CreateGenerated(path, generate);

    static long KernelLog(byte* buffer, ulong capacity)
    {
        ulong size = Log.Size();
        ulong skip = size > capacity ? size - capacity : 0;   // the newest part when it does not fit
        long n = Log.Read(skip, buffer, capacity);
        return n < 0 ? 0 : n;
    }

    static long Version(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        t.WriteLine($"Nekotia {Kernel.Version} — x86_64 kernel written in C#, transpiled to C++ by nekoc");
        return t.Length;
    }

    static long Uptime(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        ulong ms = Time.UptimeMs();
        t.WriteLine($"{ms / 1000}.{ms % 1000 / 10:D2} seconds");
        return t.Length;
    }

    static long CommandLine(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        t.WriteLine($"{(byte*)Kernel.Info->CommandLine}");
        return t.Length;
    }

    static long CpuInfo(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        t.WriteLine($"{"model name:",-14}{SysInfo.CpuBrand()}");
        t.WriteLine($"{"processors:",-14}{SysInfo.CpuCount()}");
        t.WriteLine($"{"cpu MHz:",-14}{SysInfo.CpuMhz()}");
        return t.Length;
    }

    static long MemInfo(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        VfsStats v = Vfs.Statistics();
        t.WriteLine($"{"MemTotal:",-16}{Kernel.Info->UsableMemory / 1024,10} kB");
        t.WriteLine($"{"MemFree:",-16}{Pages.FreeCount() * Pages.Size / 1024,10} kB");
        t.WriteLine($"{"HeapTotal:",-16}{(ulong)Heap.TotalBytes() / 1024,10} kB");
        t.WriteLine($"{"HeapUsed:",-16}{(ulong)Heap.UsedBytes() / 1024,10} kB");
        t.WriteLine($"{"FilesInHeap:",-16}{v.HeapBytes / 1024,10} kB");
        t.WriteLine($"{"FilesInInitrd:",-16}{v.InitrdBytes / 1024,10} kB");
        return t.Length;
    }

    static long Processes(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        t.WriteLine("PID  PARENT  THREADS  MEMORY_KB  RUNNING_MS  NAME");
        ProcessInfo p = default;
        for (uint i = 0; Process.GetInfo(i, out p); i++) {
            t.Write($"{p.Pid,-5}{p.Parent,-8}{p.Threads,-9}{p.MemoryKib,-11}{p.UptimeMs,-12}{p.Name}");
            t.WriteLine(p.State == ProcessState.Exited ? " (exited)" : "");
        }
        return t.Length;
    }

    static long Threads(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        t.WriteLine("ID   PID  CPU  CPU_MS     SWITCHES  NAME");
        ThreadInfo info = default;
        for (uint i = 0; Thread.GetInfo(i, out info); i++)
            t.WriteLine($"{info.Id,-5}{info.Pid,-5}{info.Cpu,-5}{info.CpuMs,-11}{info.Switches,-10}{info.Name}");
        return t.Length;
    }

    static long Mounts(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        MountInfo m = default;
        for (uint i = 0; Vfs.GetMount(i, out m); i++)
            t.WriteLine($"/dev/{m.Source} {m.Path} {m.Type} rw {m.FreeBytes / 1024}/{m.TotalBytes / 1024} kB free");
        return t.Length;
    }

    static long Disks(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        BlockInfo d = default;
        for (uint i = 0; Block.GetInfo(i, out d); i++)
            t.WriteLine($"{d.Name,-10}{d.Sectors,10} × {d.SectorSize,-6}{(d.ReadOnly ? "ro" : "rw"),-4}{d.Model}");
        return t.Length;
    }

    static long PciDevices(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        PciDevice d = default;
        for (uint i = 0; Pci.GetInfo(i, out d); i++)
            t.WriteLine($"{d.Bus:X2}:{d.Slot:X2}.{d.Function} {d.VendorId:X4}:{d.DeviceId:X4} {Pci.ClassName(d.Class, d.Subclass, d.ProgIf)}");
        return t.Length;
    }

    static long NetDev(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        t.WriteLine("NAME  RX_PACKETS  RX_BYTES  TX_PACKETS  TX_BYTES  DROPPED  ADDRESS");
        NetInfo n = default;
        for (uint i = 0; NetDevice.GetInfo(i, out n); i++) {
            t.Write($"{n.Name,-6}{n.RxPackets,-12}{n.RxBytes,-10}{n.TxPackets,-12}{n.TxBytes,-10}{n.RxDropped,-9}");
            if (Stack.Configured && i == Stack.Device)
                WriteIp(ref t, Stack.Address);
            t.WriteLine();
        }
        return t.Length;
    }

    static void WriteIp(ref Text t, uint ip) => t.Write($"{ip >> 24}.{(ip >> 16) & 255}.{(ip >> 8) & 255}.{ip & 255}");

    static long NetArp(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        if (!Stack.Up)
            return 0;
        byte* ip = stackalloc byte[20];
        lock (Stack.Lock) {
            for int i in 0..Arp.Size {
                ArpEntry* e = &Arp.Table[i];
                if (!e->Valid)
                    continue;
                Text address = new Text(ip, 20);
                WriteIp(ref address, e->Ip);
                t.WriteLine($"{ip,-17}{e->Mac[0]:X2}:{e->Mac[1]:X2}:{e->Mac[2]:X2}:{e->Mac[3]:X2}:{e->Mac[4]:X2}:{e->Mac[5]:X2}");
            }
        }
        return t.Length;
    }

    static long NetTcp(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        if (!Stack.Up)
            return 0;
        t.WriteLine("LOCAL                  REMOTE                 STATE  OWNER  IN/OUT");
        byte* local = stackalloc byte[24];
        byte* remote = stackalloc byte[24];
        lock (Stack.Lock) {
            for int i in 0..Tcp.Connections {
                TcpConnection* c = &Tcp.Table[i];
                if (!c->Used)
                    continue;
                Text l = new Text(local, 24);
                WriteIp(ref l, c->LocalIp);
                l.Write($":{c->LocalPort}");
                Text r = new Text(remote, 24);
                WriteIp(ref r, c->RemoteIp);
                r.Write($":{c->RemotePort}");
                t.WriteLine($"{local,-23}{remote,-23}{(byte)c->State,-7}{c->Owner,-7}{c->ReceiveCount}/{c->SendCount}");
            }
        }
        return t.Length;
    }

    static long NetUdp(byte* buffer, ulong capacity)
    {
        Text t = new Text(buffer, capacity);
        if (!Stack.Up)
            return 0;
        t.WriteLine("PORT   OWNER  QUEUED");
        lock (Stack.Lock) {
            for int i in 0..Udp.Sockets {
                UdpSocket* s = &Udp.Table[i];
                if (s->Used)
                    t.WriteLine($"{s->Port,-7}{s->Owner,-7}{s->Count}");
            }
        }
        return t.Length;
    }
}
