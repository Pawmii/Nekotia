// Boot-time self test of the runtime and of the C# → C++ translation itself.
using System;
using Nekotia;
using Nekotia.Hal;
using Nekotia.IO;
using Nekotia.OS.Net;
using Nekotia.Mem;
using Nekotia.Processes;
using Nekotia.Threading;

namespace Nekotia.OS;

public enum Shape : byte { Circle = 1, Square = 2, Triangle = 3 }

[Flags]
public enum Access : uint { None = 0, Read = 1, Write = 2, Execute = 4 }

public unsafe struct Node
{
    public Node* Next;
    public ulong Value;
}

@packed
public struct GdtEntry
{
    public ushort LimitLow;
    public ushort BaseLow;
    public byte BaseMiddle;
    public byte AccessByte;
    public byte Granularity;
    public byte BaseHigh;
}

public unsafe struct Name16
{
    public fixed byte Bytes[16];
    public int Length;
}

public class NekoError : Exception
{
    public NekoError(string message) : base(message) { }
}

public class DiskError : NekoError
{
    public DiskError(string message) : base(message) { }
}

public static unsafe class SelfTest
{
    static int _passed;
    static int _failed;
    static int _deferTrace;
    static bool _verbose;

    /// Quiet mode prints only failures and the summary (used at boot).
    /// Returns the number of failed checks.
    public static int Run(bool verbose)
    {
        _verbose = verbose;
        _passed = 0;
        _failed = 0;
        if (verbose)
            Terminal.WriteLine("selftest:");
        defer Report();

        Language();
        Patterns();
        Exceptions();
        Interpolation();
        Sugar();
        HeapBasics();
        HeapLinkedList();
        HeapCoalescing();
        HeapGrowth();
        PageFrames();
        BuddyBlocks();
        Paging();
        Threads();
        PciBus();
        FileSystem();
        Disks();
        ProcFiles();
        FatVolume();
        Networking();
        UserMode();
        return _failed;
    }

    static void Report()
    {
        Terminal.Write("selftest: ");
        Terminal.Write(_failed == 0 ? AnsiColor.Green : AnsiColor.BrightRed, _failed == 0 ? "ok" : "FAILED");
        Terminal.WriteLine($" — {_passed} passed, {_failed} failed");
    }

    static void Check(bool ok, string name)
    {
        if (ok) {
            _passed++;
            if (!_verbose)
                return;
            Terminal.Write(AnsiColor.Green, "  ok    ");
        } else {
            _failed++;
            Terminal.Write(AnsiColor.BrightRed, "  FAIL  ");
        }
        Terminal.WriteLine(name);
    }

    static int Classify(int v) => v switch
    {
        < 0 => -1,
        0 => 0,
        >= 1 and <= 9 => 1,
        10 or 20 or 30 => 2,
        _ when v % 2 == 0 => 3,
        _ => 4,
    };

    static string Size(ulong bytes) => bytes switch
    {
        < 1024 => "small",
        < 1024 * 1024 => "medium",
        _ => "large",
    };

    static int _sideEffects;
    static int Next() => ++_sideEffects;

    static int PatternLoop()
    {
        int sum = 0;
        for int i in 0..20 {
            switch (i)
            {
                case < 5:
                    continue;   // must continue the loop, not leave a hidden do/while
                case 7 or 9:
                    sum += 100;
                    break;
                case > 15 when i % 2 == 0:
                    sum += 1000;
                    break;
                default:
                    sum += 1;
                    break;
            }
        }
        return sum;
    }

    // ---------------------------------------------------------------- exceptions

    static ulong _trace;
    static void Mark(int digit) => _trace = _trace * 10 + (ulong)digit;

    static void Thrower(int kind)
    {
        defer Mark(1);
        if (kind == 1)
            throw new InvalidOperationException("bad state");
        if (kind == 2)
            throw new DiskError("disk on fire");
        if (kind == 3)
            throw new NekoError("plain neko");
    }

    static void Deeper(int kind)
    {
        defer Mark(2);
        Thrower(kind);
        Mark(9);   // never after a throw
    }

    static int Catches(int kind)
    {
        try {
            Deeper(kind);
            return 0;
        } catch (DiskError e) {
            return Str.Equals(e.Message, "disk on fire") ? 2 : -2;
        } catch (NekoError) {
            return 3;
        } catch (InvalidOperationException e) when (Str.Equals(e.Message, "bad state")) {
            return 1;
        }
    }

    static int Rethrows()
    {
        try {
            try {
                Thrower(2);
            } catch (NekoError) {
                Mark(5);
                throw;
            } finally {
                Mark(6);
            }
        } catch (DiskError e) {
            return Str.Equals(e.Message, "disk on fire") ? 7 : -7;
        }
        return 0;
    }

    static int FinallyOnReturn()
    {
        try {
            Mark(3);
            return 4;
        } finally {
            Mark(8);
        }
    }

    static Mutex _excLock;

    static void Exceptions()
    {
        nuint heap = Heap.UsedBytes();
        _trace = 0;
        Check(Catches(0) == 0 && _trace == 192, "try: no exception; every defer ran once in order");
        _trace = 0;
        Check(Catches(1) == 1 && _trace == 12, "catch with a when-filter; the defers of both callees ran while unwinding");
        _trace = 0;
        Check(Catches(2) == 2, "catch by the exact type, with e.Message");
        Check(Catches(3) == 3, "catch by a base class (DiskError → NekoError handler order)");
        _trace = 0;
        Check(Rethrows() == 7 && _trace == 156, "throw; from a catch: the inner finally runs, the outer catch gets it");
        _trace = 0;
        Check(FinallyOnReturn() == 4 && _trace == 38, "finally runs on return");

        try {
            lock (_excLock) {
                Thrower(1);
            }
        } catch (Exception) {
        }
        Check(!_excLock.IsLocked(), "a lock is released when an exception leaves it");

        int kept = 0;
        long sum = 0;
        for int i in 0..10 {
            try {
                kept = i;
                if (i == 3)
                    continue;
                if (i == 8)
                    break;
                if (i % 2 == 0)
                    Thrower(1);
                sum += i;
            } catch (InvalidOperationException) {
                sum += 100;
            }
        }
        Check(kept == 8 && sum == 1 + 5 + 7 + 100 * 4, "locals written in try keep their values; break/continue leave try");

        bool caught = false;
        try {
            try {
                Thrower(3);
            } catch (DiskError) {
                caught = false;   // not this one
            }
        } catch (NekoError e) {
            caught = Str.Equals(e.Message, "plain neko");
        }
        Check(caught, "an unmatched catch passes the exception outward");
        Check(Heap.UsedBytes() == heap, "exceptions allocate nothing");
    }

    static void Interpolation()
    {
        byte* buf = stackalloc byte[128];
        Text t = new Text(buf, 128);
        int n = -42;
        ulong big = 4096;
        byte* name = Str.Bytes("neko");
        t.Write($"[{n}|{big:size}|{name}|{255:X}|{0xBEEF:X6}|{7:D3}|{1.5:F2}|{true}]");
        Check(Str.Equals(buf, "[-42|4 KiB|neko|0xff|00beef|007|1.50|true]"), "interpolation into a Text buffer (numbers, sizes, byte* C strings, formats)");
        t = new Text(buf, 128);
        t.Write($"<{n,5}|{n,-5}|{"ab",4}|{name,-6}|{3,4:X2}>");
        Check(Str.Equals(buf, "<  -42|-42  |  ab|neko  |  03>"), "interpolation alignment: right, left, strings, byte*, hex digits");
        Text small = new Text(buf, 6);
        small.Write($"{123456789}");
        Check(small.Length == 5 && Str.Equals(buf, "12345"), "Text never writes past its capacity");
    }

    static void Patterns()
    {
        Check(Classify(-5) == -1 && Classify(0) == 0 && Classify(7) == 1 && Classify(20) == 2 && Classify(44) == 3 && Classify(45) == 4,
              "switch expression: relational, or/and, when, discard");
        Check(Str.Equals(Size(10), "small") && Str.Equals(Size(5000), "medium") && Str.Equals(Size(1UL << 30), "large"),
              "switch expression producing strings");
        char c = 'q';
        Check(c is >= 'a' and <= 'z' && c is not ('x' or 'y') && !(c is >= '0' and <= '9'), "is-patterns on a char");
        _sideEffects = 0;
        bool small = Next() is > 0 and < 10;
        Check(small && _sideEffects == 1, "the subject of a pattern is evaluated once");
        byte* none = null;
        Check(none is null && Str.Bytes("x") is not null, "null patterns");
        // 5…19 except 7, 9 and the even ones above 15: 11 × 1 + 2 × 100 + 2 × 1000 (16, 18)
        Check(PatternLoop() == 1 * 11 + 200 + 2000, "switch statement with patterns: break, continue, when, default");
    }

    static void Language()
    {
        var a = new Point(3, -4);
        var b = a + new Point(1, 1);
        Check(b.X == 4 && b.Y == -3 && a.ManhattanLength == 7, "structs: ctor, operator +, property");

        var r = new Rect { Origin = new Point(10, 10), Width = 5, Height = 4 };
        Check(r.Area == 20 && r.Contains(new Point(12, 13)) && !r.Contains(new Point(15, 10)), "structs: object initializer, methods");

        Check(Sides(Shape.Square) == 4 && Sides(Shape.Circle) == 0 && Sides((Shape)3) == 3, "enums + switch");

        Access acc = Access.Read | Access.Write;
        Check((acc & Access.Write) != 0 && (acc & Access.Execute) == 0, "[Flags] enum operators");

        Check(sizeof(GdtEntry) == 8, "@packed struct has no padding");

        uint big = 0xFFFFFFF0;
        int neg = -32;
        Check(big + neg == 0xFFFFFFD0L, "C# integer promotion (uint + int is long)");

        Name16 name = default;
        for int i in 0..4 { name.Bytes[i] = (byte)('a' + i); }
        name.Length = 4;
        Check(name.Bytes[3] == (byte)'d' && name.Bytes[4] == 0, "fixed buffers");

        byte* scratch = stackalloc byte[32];
        Check(scratch[0] == 0 && scratch[31] == 0, "stackalloc is zeroed");

        delegate*<int, int> twice = &Twice;
        Check(twice(21) == 42, "function pointers (delegate*)");
    }

    static int Twice(int v) => v * 2;

    static int Sides(Shape s)
    {
        switch (s)
        {
            case Shape.Circle:
                return 0;
            case Shape.Square:
                return 4;
            default:
                return 3;
        }
    }

    static void Sugar()
    {
        _deferTrace = 0;
        {
            defer _deferTrace = _deferTrace * 10 + 1;
            defer _deferTrace = _deferTrace * 10 + 2;
            _deferTrace = 9;
        }
        Check(_deferTrace == 921, "defer runs in reverse order at scope exit");

        ulong sum = 0;
        for ulong i in 1..=10 { sum += i; }
        Check(sum == 55, "for i in a..=b (inclusive range)");

        int spins = 0;
        loop {
            spins++;
            if (spins == 3) break;
        }
        Check(spins == 3, "loop { } with break");

        Arch.Pause();
        Check(true, "asm block compiles");

        double root2 = Maths.Sqrt(2.0);
        float half = 0.5f;
        int whole = 7;
        double mixed = whole / 2.0 + half;   // int → double promotion like C#
        Check(Maths.Abs(root2 - 1.41421356237) < 1e-9 && mixed == 4.0, "float/double arithmetic (SSE)");
        Check(Maths.Abs(Maths.Sin(Maths.Pi / 6) - 0.5) < 1e-12 && Maths.Abs(Maths.Cos(Maths.Pi) + 1) < 1e-12 &&
              Maths.Abs(Maths.Log(Maths.Exp(3.0)) - 3.0) < 1e-12 && Maths.Pow(2.0, 10.0) == 1024.0,
              "Maths: sin, cos, exp, log, pow");
        Check((int)(-2.7) == -2 && Maths.Floor(-2.5) == -3.0 && Maths.Atan2(1.0, 1.0) - Maths.Pi / 4 < 1e-12, "float → int truncation, floor, atan2");

        const string table = "aй€";
        Check(table.Length == 3 && table[1] == 'й' && table[2] == 0x20AC, "constant string indexing (UTF-16 semantics)");
    }

    static void HeapBasics()
    {
        nuint before = Heap.UsedBytes();
        byte* p = (byte*)Heap.Alloc(100);
        Check(p != null && ((ulong)p & 15) == 0, "heap: alloc returns 16-byte aligned memory");

        Memory.Set(p, 0xAB, 100);
        p = (byte*)Heap.Realloc(p, 4000);
        Check(p != null && p[0] == 0xAB && p[99] == 0xAB, "heap: realloc keeps contents");

        Heap.Free(p);
        Check(Heap.UsedBytes() == before && Heap.Check(), "heap: free returns everything");
    }

    static void HeapLinkedList()
    {
        Node* head = null;
        for ulong i in 0..100 {
            Node* n = Heap.New<Node>();
            n->Value = i;
            n->Next = head;
            head = n;
        }

        ulong sum = 0;
        for (Node* it = head; it != null; it = it->Next)
            sum += it->Value;

        while (head != null) {
            Node* next = head->Next;
            Heap.Delete(head);
            head = next;
        }
        Check(sum == 4950 && Heap.Check(), "heap: 100-node linked list via Heap.New<T>()");
    }

    static void HeapCoalescing()
    {
        nuint blocks = Heap.BlockCount();
        void* a = Heap.Alloc(256);
        void* b = Heap.Alloc(256);
        void* c = Heap.Alloc(256);
        Heap.Free(a);
        Heap.Free(c);
        Heap.Free(b);
        Check(Heap.BlockCount() == blocks && Heap.Check(), "heap: neighbours coalesce after free");
    }

    static void HeapGrowth()
    {
        nuint total = Heap.TotalBytes();
        byte* big = (byte*)Heap.Alloc(total + 1024 * 1024);   // larger than the whole heap right now
        Check(big != null && Heap.TotalBytes() > total, "heap: grows on demand");
        if (big != null) {
            big[0] = 1;
            big[total] = 2;
            Heap.Free(big);
        }
        Check(Heap.Check(), "heap: consistent after growing");
    }

    static void BuddyBlocks()
    {
        ulong before = Pages.FreeCount();
        byte* block = (byte*)Pages.AllocContiguous(8);
        ulong phys = Pages.VirtToPhys(block);
        Check(block != null && phys % (8 * Pages.Size) == 0 && block[8 * 4096 - 1] == 0, "buddy: 8 contiguous zeroed pages, 32 KiB aligned");
        if (VirtualMemory.Ready())
            Check(VirtualMemory.Translate((ulong)(block + 7 * 4096)) == phys + 7 * 4096, "buddy: physically contiguous (checked through the page tables)");
        Pages.FreeContiguous(block, 8);
        Check(Pages.FreeCount() == before, "buddy: freed block merges back");
    }

    static void Paging()
    {
        unless (VirtualMemory.Ready())
            return;   // host mode has no page tables
        ulong virt = VirtualMemory.FreeBase + 7 * Pages.Size;
        ulong* frame = (ulong*)Pages.Alloc();
        ulong phys = Pages.VirtToPhys(frame);
        bool mapped = VirtualMemory.Map(virt, phys, PageFlags.Write);
        *(ulong*)virt = 0xC0FFEE;
        Check(mapped && VirtualMemory.Translate(virt) == phys && *frame == 0xC0FFEE, "paging: map a frame at a second address");
        Check(!VirtualMemory.Map(virt, phys, PageFlags.Write), "paging: refuses to map over an existing page");
        VirtualMemory.Unmap(virt);
        Check(VirtualMemory.Translate(virt) == VirtualMemory.Unmapped, "paging: unmap");
        Pages.Free(frame);
        Check(VirtualMemory.IsStackGuard(VirtualMemory.StackBase), "paging: kernel stack has a guard page");
    }

    // ---------------------------------------------------------------- threads

    static Mutex _counterLock;
    static Semaphore _done;
    static ulong _counter;
    static volatile bool _stop;
    static volatile int _spins;
    static int _pingPong;
    static Semaphore _ping;
    static Semaphore _pong;

    static void Increment(ulong times)
    {
        for ulong i in 0ul..times {
            lock (_counterLock) {
                ulong v = _counter;
                if (i % 64 == 0)
                    Thread.Yield();      // make lost updates likely if the mutex did not work
                _counter = v + 1;
            }
        }
        _done.Signal();
    }

    static void Spinner(ulong unused)
    {
        while (!_stop)
            _spins = _spins + 1;     // never yields
        _done.Signal();
    }

    static volatile uint _cpuMask;

    static void CpuProbe(ulong ms)
    {
        ulong until = Time.UptimeMs() + ms;
        while (Time.UptimeMs() < until)
            _cpuMask = _cpuMask | (1u << (int)Thread.CurrentCpu());
        _done.Signal();
    }

    static int Bits(uint v)
    {
        int n = 0;
        for (; v != 0; v &= v - 1)
            n++;
        return n;
    }

    static void Ponger(ulong rounds)
    {
        for ulong i in 0ul..rounds {
            _ping.Wait();
            _pingPong++;
            _pong.Signal();
        }
    }

    static void Threads()
    {
        _counterLock.SetName("selftest.counter");
        _counter = 0;
        for int i in 0..3 {
            Thread.Start("selftest-inc", &Increment, 1000);
        }
        for int i in 0..3 { _done.Wait(); }
        Check(_counter == 3000, "threads: 3 × 1000 increments under a mutex");

        ulong start = Time.UptimeMs();
        Thread.Sleep(20);
        ulong slept = Time.UptimeMs() - start;
        Check(slept >= 20 && slept < 40, "threads: Sleep(20) blocks ~20 ms");

        _pingPong = 0;
        Thread.Start("selftest-pong", &Ponger, 100);
        for int i in 0..100 {
            _ping.Signal();
            _pong.Wait();
        }
        Check(_pingPong == 100, "threads: semaphore ping-pong × 100");

        if (!Kernel.Info->Hosted) {           // no timer interrupt in host mode
            _stop = false;
            _spins = 0;
            Thread.Start("selftest-spin", &Spinner, 0);
            Thread.Sleep(30);                   // the spinner never yields: only preemption brings us back
            int seen = _spins;
            _stop = true;
            _done.Wait();
            Check(seen > 0, "threads: preemption (a thread that never yields gets interrupted)");
        }

        if (SysInfo.CpuCount() > 1) {
            _cpuMask = 0;
            for int i in 0..4 { Thread.Start("selftest-cpu", &CpuProbe, 40); }
            for int i in 0..4 { _done.Wait(); }
            Check(Bits(_cpuMask) > 1, "smp: busy threads run on several CPUs at once");
        }
    }

    static void PageFrames()
    {
        ulong free = Pages.FreeCount();
        byte* page = (byte*)Pages.Alloc();
        Check(page != null && Pages.VirtToPhys(page) % Pages.Size == 0 && page[4095] == 0, "pages: alloc gives a zeroed, aligned frame");
        Pages.Free(page);
        Check(Pages.FreeCount() == free, "pages: free puts it back");
    }

    // ---------------------------------------------------------------- user mode (user/usertest)

    static long RunAndWait(string name, string args)
    {
        long pid = Process.Start(name, args);
        return pid > 0 ? Process.Wait((uint)pid) : pid;
    }

    static void PciBus()
    {
        if (Kernel.Info->Hosted)
            return;
        Check(Pci.Count() > 0, "pci: the bus scan found devices");
        int host = Pci.FindClass(0x06, 0x00);
        Check(host >= 0, "pci: there is a host bridge (class 06.00)");
        PciDevice d = default;
        Check(host >= 0 && Pci.GetInfo((uint)host, out d) && (uint)Pci.Read16((uint)host, 0) == d.VendorId,
              "pci: configuration reads match the scanned table");
        Check(Pci.Find(0xFFFF, 0xFFFF, Pci.Count()) == -1, "pci: lookups past the end find nothing");
    }

    static long Put(string path, byte* data, ulong length, uint flags)
    {
        OpenFile* f = null;
        long e = Vfs.Open(path, flags, out f);
        if (e < 0)
            return e;
        e = Vfs.WriteFile(f, data, length);
        Vfs.Close(f);
        return e;
    }

    /// Reads `path` into `buffer` (NUL-terminated); bytes read or an error.
    static long Get(string path, byte* buffer, ulong capacity)
    {
        OpenFile* f = null;
        long e = Vfs.Open(path, Vfs.Read, out f);
        if (e < 0)
            return e;
        long n = Vfs.ReadFile(f, buffer, capacity - 1);
        Vfs.Close(f);
        if (n >= 0)
            buffer[n] = 0;
        return n;
    }

    static void FileSystem()
    {
        nuint heap = Heap.UsedBytes();
        ulong nodes = Vfs.Statistics().Nodes;
        byte* buf = stackalloc byte[128];
        FileStat st = default;

        Check(Vfs.Stat("/", out st) == 0 && st.Type == NodeType.Directory, "vfs: the root is a directory");
        Check(Vfs.Stat("/dev/console", out st) == 0 && st.Type == NodeType.Device, "vfs: /dev/console is a device");
        Check(Vfs.CreateDirectory("/tmp/selftest") == 0, "vfs: mkdir");
        Check(Vfs.CreateDirectory("/tmp/selftest") == Process.ErrExists, "vfs: mkdir of an existing name fails (exists)");

        Check(Put("/tmp/selftest/a", Str.Bytes("hello"), 5, Vfs.Write | Vfs.Create) == 5, "vfs: create + write");
        Check(Put("/tmp/selftest/a", Str.Bytes(", world"), 7, Vfs.Write | Vfs.Append) == 7, "vfs: append");
        Check(Get("/tmp/selftest/a", buf, 128) == 12 && Str.Equals(buf, "hello, world"), "vfs: read back");

        OpenFile* f = null;
        Vfs.Open("/tmp/selftest/a", Vfs.Read | Vfs.Write, out f);
        Check(Vfs.Seek(f, 7, Vfs.SeekSet) == 7 && Vfs.WriteFile(f, Str.Bytes("there"), 5) == 5, "vfs: seek + overwrite");
        Check(Vfs.Seek(f, 20, Vfs.SeekSet) == 20 && Vfs.WriteFile(f, Str.Bytes("!"), 1) == 1 && Vfs.Stat(f, out st) == 0 && st.Size == 21,
              "vfs: writing past the end grows the file");
        Vfs.Seek(f, 12, Vfs.SeekSet);
        Check(Vfs.ReadFile(f, buf, 8) == 8 && buf[0] == 0 && buf[7] == 0, "vfs: the hole reads as zeros");
        Check(Vfs.SetLength(f, 5) == 0 && Vfs.Stat(f, out st) == 0 && st.Size == 5, "vfs: truncate");
        Check(Vfs.Seek(f, -1, Vfs.SeekSet) == Process.ErrBadArgument, "vfs: seeking before the start fails");
        Vfs.Close(f);
        Check(Get("/tmp/selftest/a", buf, 128) == 5 && Str.Equals(buf, "hello"), "vfs: contents after truncate");

        Check(Vfs.Open("/tmp/selftest/missing", Vfs.Read, out f) == Process.ErrNotFound, "vfs: opening a missing file fails (not found)");
        Check(Vfs.Open("/tmp/selftest", Vfs.Write, out f) == Process.ErrIsDirectory, "vfs: a directory cannot be opened for writing");
        Check(Vfs.Open("/tmp/selftest/a/b", Vfs.Read, out f) == Process.ErrNotDirectory, "vfs: a file is not a directory in a path");
        Check(Vfs.Open("/tmp/selftest/a", Vfs.Write | Vfs.Create | Vfs.Exclusive, out f) == Process.ErrExists, "vfs: exclusive create of an existing file fails");

        // Working directory and relative paths.
        Check(Vfs.ChangeDirectory("/tmp/selftest") == 0 && Vfs.CurrentDirectory(buf, 128) == 13 && Str.Equals(buf, "/tmp/selftest"),
              "vfs: chdir + getcwd");
        Check(Vfs.Stat("a", out st) == 0 && st.Size == 5 && Vfs.Stat("../selftest/./a", out st) == 0, "vfs: relative paths, . and ..");
        Check(Vfs.CreateDirectory("sub") == 0 && Vfs.Rename("a", "sub/b") == 0 && Vfs.Stat("sub/b", out st) == 0 && !Vfs.Exists("a"),
              "vfs: rename moves between directories");
        Check(Vfs.Rename("/tmp/selftest", "/tmp/selftest/sub/x") == Process.ErrBusy, "vfs: a directory cannot move into itself");
        Check(Vfs.Remove("sub") == Process.ErrNotEmpty, "vfs: removing a non-empty directory fails");

        // A removed file stays readable through an open file until it is closed.
        Vfs.Open("sub/b", Vfs.Read, out f);
        Check(Vfs.Remove("sub/b") == 0 && !Vfs.Exists("sub/b"), "vfs: remove");
        Check(Vfs.ReadFile(f, buf, 128) == 5, "vfs: an open file outlives its name");
        Vfs.Close(f);

        Vfs.Open("/tmp/selftest", Vfs.Read, out f);
        DirEntry e = default;
        Check(Vfs.ReadDirectory(f, 0, out e) == 1 && Str.Equals(e.Name, "sub") && e.Type == NodeType.Directory
              && Vfs.ReadDirectory(f, 1, out e) == 0, "vfs: readdir");
        Vfs.Close(f);

        Check(Vfs.ChangeDirectory("/") == 0 && Vfs.Remove("/tmp/selftest/sub") == 0 && Vfs.Remove("/tmp/selftest") == 0,
              "vfs: removing empty directories");
        Check(Vfs.Remove("/") == Process.ErrBusy, "vfs: the root cannot be removed");

        Vfs.Open("/dev/zero", Vfs.Read, out f);
        buf[0] = 1;
        Check(Vfs.ReadFile(f, buf, 16) == 16 && buf[0] == 0 && buf[15] == 0, "vfs: /dev/zero");
        Vfs.Close(f);
        Check(Put("/dev/null", buf, 16, Vfs.Write) == 16 && Get("/dev/null", buf, 16) == 0, "vfs: /dev/null");

        OpenFile* r = null;
        OpenFile* w = null;
        Check(Vfs.Pipe(out r, out w) == 0 && Vfs.WriteFile(w, Str.Bytes("pipe!"), 5) == 5, "pipe: write");
        Check(Vfs.ReadFile(r, buf, 3) == 3 && buf[0] == 'p' && Vfs.ReadFile(r, buf, 16) == 2 && buf[1] == '!', "pipe: read in pieces");
        Vfs.Close(w);
        Check(Vfs.ReadFile(r, buf, 16) == 0, "pipe: end of input once the writer is closed");
        Vfs.Close(r);

        Check(Vfs.Statistics().Nodes == nodes && Vfs.Statistics().OpenFiles == 0 && Heap.UsedBytes() == heap,
              "vfs: nodes, open files and memory are all freed");

        if (Kernel.Info->Hosted)
            return;
        Check(Vfs.Statistics().InitrdEntries > 0 && Vfs.Exists("/bin/sh"), "initrd: unpacked at boot (/bin/sh)");
        Check(Get("/etc/motd", buf, 16) == 15 && Str.StartsWith(buf, "Things to try"), "initrd: /etc/motd reads straight from the module");
    }

    /// The block layer on a RAM disk (host mode) or, under `make test` only, on the scratch virtio disk
    /// QEMU gets there — a normal boot never writes to a disk.
    static void ProcFiles()
    {
        if (!Vfs.Exists("/proc/version"))
            return;
        byte* buf = stackalloc byte[64];
        Check(Get("/proc/version", buf, 64) > 20 && Str.StartsWith(buf, "Nekotia "), "proc: /proc/version is generated");
        OpenFile* f = null;
        Vfs.Open("/proc/version", Vfs.Read, out f);
        long a = Vfs.ReadFile(f, buf, 4);
        long b = Vfs.ReadFile(f, buf + 4, 4);
        Vfs.Close(f);
        Check(a == 4 && b == 4 && buf[0] == 'N' && buf[4] == 't', "proc: reads continue at the file offset");
        Check(Vfs.Open("/proc/version", Vfs.Write, out f) == 0 && Vfs.WriteFile(f, buf, 1) == Process.ErrNotSupported, "proc: files are read-only");
        Vfs.Close(f);
    }

    static void Disks()
    {
        if (Kernel.Info->Hosted) {
            if (Block.Find("ram0") < 0)
                Block.AddRamDisk("ram0", 1024 * 1024);
            DiskTest("ram0");
            return;
        }
        if (!Str.StartsWith(Kernel.Info->CommandLine, "test"))
            return;
        Check(Block.Find("vda") >= 0, "disk: virtio-blk found the test disk (vda)");
        Check(Block.Find("sda") >= 0, "disk: AHCI found the SATA test disk (sda)");
        Check(Block.Find("nvme0n1") >= 0, "disk: NVMe found the test drive (nvme0n1)");
        DiskTest("vda");
        DiskTest("sda");
        DiskTest("nvme0n1");
        int cd = Block.Find("cd0");
        BlockInfo info = default;
        byte* sector = (byte*)Heap.Alloc(2048);
        defer Heap.Free(sector);
        Check(cd >= 0 && Block.GetInfo((uint)cd, out info) && info.SectorSize == 2048 && info.ReadOnly
              && Block.Read((uint)cd, 16, 1, sector) == 0 && sector[1] == 'C' && sector[2] == 'D' && sector[5] == '1',
              "disk: the boot CD reads over ATAPI (ISO 9660 volume descriptor)");
        Check(Block.Write((uint)cd, 16, 1, sector) == Process.ErrAccess, "disk: the CD is read-only");

        UsbDevice u = default;
        bool keyboard = false, mouse = false;
        for (uint i = 0; Usb.GetInfo(i, out u); i++) {
            keyboard |= u.Kind == 1 && u.VendorId == 0x0627;
            mouse |= u.Kind == 2;
        }
        Check(keyboard && mouse, "usb: xHCI enumerated the HID keyboard and mouse");
        ulong before = 0;
        for (uint i = 0; Usb.GetInfo(i, out u); i++) {
            before += u.Reports;
        }
        Thread.Sleep(100);
        ulong after = 0;
        for (uint i = 0; Usb.GetInfo(i, out u); i++) {
            after += u.Reports;
        }
        Check(after > before, "usb: interrupt endpoints deliver reports");
    }

    /// Writes, reads back and byte-addresses a scratch disk (only ever under `make test` or a RAM disk).
    static void DiskTest(string name)
    {
        int disk = Block.Find(name);
        if (disk < 0)
            return;
        uint d = (uint)disk;
        BlockInfo info = default;
        Check(Block.GetInfo(d, out info) && info.SectorSize == 512 && info.Sectors >= 2048 && !info.ReadOnly, "disk: size and sector size");

        const int Big = 200 * 1024;   // spans several 64 KiB DMA buffers of the virtio driver
        byte* data = (byte*)Heap.Alloc(Big);
        byte* back = (byte*)Heap.AllocZeroed(Big);
        defer Heap.Free(data);
        defer Heap.Free(back);
        for int i in 0..Big { data[i] = (byte)(i * 7 + (i >> 9)); }
        Check(Block.Write(d, 8, Big / 512, data) == 0 && Block.Read(d, 8, Big / 512, back) == 0 && Memory.Compare(data, back, Big) == 0,
              "disk: 200 KiB written and read back");
        Check(Block.Read(d, info.Sectors, 1, back) == Process.ErrBadArgument && Block.Read(d, info.Sectors - 1, 1, back) == 0,
              "disk: the last sector is the end");
        Check(Block.Flush(d) == 0, "disk: flush");

        // Byte access through /dev: a write across a sector boundary is read-modify-written.
        byte* path = stackalloc byte[24];
        Files.Join("/dev", info.Name, path);
        OpenFile* f = null;
        Check(Vfs.Open(path, Vfs.Read | Vfs.Write, out f) == 0, "disk: /dev node opens");
        Vfs.Seek(f, 8 * 512 + 510, Vfs.SeekSet);
        Check(Vfs.WriteFile(f, Str.Bytes("neko"), 4) == 4, "disk: unaligned write through /dev");
        Vfs.Seek(f, 8 * 512 + 508, Vfs.SeekSet);
        Check(Vfs.ReadFile(f, back, 8) == 8 && back[0] == data[508] && back[1] == data[509] && back[2] == 'n' && back[5] == 'o'
              && back[6] == data[514] && back[7] == data[515], "disk: neighbouring bytes survive");
        FileStat st = default;
        Check(Vfs.Stat(f, out st) == 0 && st.Size == info.Sectors * 512 && Vfs.Seek(f, 0, Vfs.SeekEnd) == (long)st.Size,
              "disk: /dev size and seek to the end");
        Vfs.Close(f);
    }

    static ulong FreeBytes(string path)
    {
        MountInfo m = default;
        for (uint i = 0; Vfs.GetMount(i, out m); i++) {
            if (Str.Equals(m.Path, path))
                return m.FreeBytes;
        }
        return 0;
    }

    /// FAT32 end to end: on a 40 MiB RAM disk in host mode, on the second scratch disk (vdb) under `make test`.
    static void FatVolume()
    {
        byte* dev = null;
        if (Kernel.Info->Hosted) {
            if (Block.Find("ram1") < 0)
                Block.AddRamDisk("ram1", 40 * 1024 * 1024);
            dev = Str.Bytes("ram1");
        } else if (Str.StartsWith(Kernel.Info->CommandLine, "test") && Block.Find("vdb") >= 0) {
            dev = Str.Bytes("vdb");
        }
        if (dev == null)
            return;
        const int Big = 100 * 1024 + 17;   // ~200 clusters of 512 bytes
        byte* data = (byte*)Heap.Alloc(Big);
        byte* back = (byte*)Heap.AllocZeroed(Big);
        defer Heap.Free(data);
        defer Heap.Free(back);
        nuint heap = Heap.UsedBytes();
        ulong nodes = Vfs.Statistics().Nodes;
        byte* dir = Str.Bytes("/tmp/fat");
        byte* buf = stackalloc byte[128];
        FileStat st = default;

        Check(Fat.Format(dev, Str.Bytes("SELFTEST")) == 0 && Fat.Probe(dev), "fat32: format");
        Vfs.CreateDirectory(dir);
        Check(Fat.Mount(dev, dir) == 0, "fat32: mount");
        ulong free = FreeBytes("/tmp/fat");
        Check(free > 30 * 1024 * 1024, "fat32: free space reported");

        Check(Put("/tmp/fat/hello.txt", Str.Bytes("hello, fat"), 10, Vfs.Write | Vfs.Create) == 10, "fat32: create a file (8.3 name)");
        Check(Put("/tmp/fat/A long file name.text", Str.Bytes("long"), 4, Vfs.Write | Vfs.Create) == 4, "fat32: create a file (long name)");
        Check(Vfs.CreateDirectory("/tmp/fat/dir") == 0 && Vfs.CreateDirectory("/tmp/fat/dir/Sub Directory") == 0, "fat32: mkdir, nested");

        for int i in 0..Big { data[i] = (byte)(i * 13 + (i >> 8)); }
        Check(Put("/tmp/fat/dir/Sub Directory/big.bin", data, Big, Vfs.Write | Vfs.Create) == Big, "fat32: write 100 KiB");
        OpenFile* f = null;
        Vfs.Open("/tmp/fat/dir/Sub Directory/big.bin", Vfs.Read | Vfs.Write, out f);
        Check(Vfs.ReadFile(f, back, Big) == Big && Memory.Compare(data, back, Big) == 0, "fat32: read it back");
        Vfs.Seek(f, 50000, Vfs.SeekSet);
        Check(Vfs.WriteFile(f, Str.Bytes("NEKO"), 4) == 4, "fat32: overwrite in the middle");
        data[50000] = (byte)'N';
        data[50001] = (byte)'E';
        data[50002] = (byte)'K';
        data[50003] = (byte)'O';
        Check(Vfs.Remove("/tmp/fat/dir/Sub Directory/big.bin") == Process.ErrBusy, "fat32: an open file cannot be removed");
        Check(Vfs.Unmount(dir) == Process.ErrBusy, "fat32: a volume with open files cannot be unmounted");
        Vfs.Close(f);

        Check(Vfs.Rename("/tmp/fat/hello.txt", "/tmp/fat/dir/Moved File.txt") == 0, "fat32: rename into another directory");
        Check(Vfs.Rename("/tmp/fat/dir/Sub Directory", "/tmp/fat/sub") == 0, "fat32: move a directory");
        Check(Vfs.Rename("/tmp/fat/A long file name.text", "/tmp/nope") == Process.ErrNotSupported, "fat32: rename across volumes is refused");
        Check(Put("/tmp/fat/gap.bin", Str.Bytes("x"), 1, Vfs.Write | Vfs.Create) == 1, "fat32: small file");
        Vfs.Open("/tmp/fat/gap.bin", Vfs.Write, out f);
        Vfs.Seek(f, 3000, Vfs.SeekSet);
        Check(Vfs.WriteFile(f, Str.Bytes("y"), 1) == 1 && Vfs.Stat(f, out st) == 0 && st.Size == 3001, "fat32: writing past the end");
        Vfs.Close(f);

        // Everything must come back from the disk alone.
        Check(Vfs.Unmount(dir) == 0 && !Vfs.Exists("/tmp/fat/dir"), "fat32: unmount");
        Check(Fat.Mount(dev, dir) == 0, "fat32: mount again");
        Check(Get("/tmp/fat/dir/Moved File.txt", buf, 128) == 10 && Str.Equals(buf, "hello, fat"), "fat32: renamed file persisted");
        Check(Get("/tmp/fat/A long file name.text", buf, 128) == 4 && Str.Equals(buf, "long"), "fat32: long name persisted");
        Memory.Set(back, 0, (nuint)Big);
        Vfs.Open("/tmp/fat/sub/big.bin", Vfs.Read, out f);
        Check(f != null && Vfs.ReadFile(f, back, Big) == Big && Memory.Compare(data, back, Big) == 0, "fat32: 100 KiB persisted in the moved directory");
        Vfs.Close(f);
        Vfs.Open("/tmp/fat/gap.bin", Vfs.Read, out f);
        Check(Vfs.ReadFile(f, back, 4000) == 3001 && back[0] == 'x' && back[1] == 0 && back[2999] == 0 && back[3000] == 'y', "fat32: the gap reads as zeros");
        Vfs.SetLength(f, 0);
        Vfs.Close(f);
        Vfs.Open("/tmp/fat/gap.bin", Vfs.Write, out f);
        Check(Vfs.SetLength(f, 10) == 0 && Vfs.Stat(f, out st) == 0 && st.Size == 10, "fat32: truncate");
        Vfs.Close(f);

        Check(Vfs.Remove("/tmp/fat/sub") == Process.ErrNotEmpty, "fat32: a non-empty directory stays");
        bool removed = Vfs.Remove("/tmp/fat/sub/big.bin") == 0 && Vfs.Remove("/tmp/fat/sub") == 0
            && Vfs.Remove("/tmp/fat/dir/Moved File.txt") == 0 && Vfs.Remove("/tmp/fat/dir") == 0
            && Vfs.Remove("/tmp/fat/gap.bin") == 0 && Vfs.Remove("/tmp/fat/A long file name.text") == 0;
        Check(removed && FreeBytes("/tmp/fat") == free, "fat32: removing everything frees every cluster");
        // Left on the volume for scripts/fatcheck.py, which `make test` runs on the image afterwards.
        Check(Vfs.CreateDirectory("/tmp/fat/Kept by selftest") == 0
              && Put("/tmp/fat/Kept by selftest/Привет, мир.txt", Str.Bytes("persisted\n"), 10, Vfs.Write | Vfs.Create) == 10
              && Put("/tmp/fat/readme.txt", Str.Bytes("nekotia\n"), 8, Vfs.Write | Vfs.Create) == 8, "fat32: files with Cyrillic and short names");
        Check(Vfs.Unmount(dir) == 0 && Vfs.Remove(dir) == 0, "fat32: final unmount");
        Check(Vfs.Statistics().Nodes == nodes && Heap.UsedBytes() == heap, "fat32: nodes and memory are freed");
    }

    /// Under QEMU's user network (`make test` and `make run` attach one): DHCP, ARP, ping, UDP over loopback.
    static void Networking()
    {
        if (!Stack.Up)
            return;
        Check(Stack.Configured && Stack.Address == 0x0A00020F && Stack.Gateway == 0x0A000202, "net: DHCP gave 10.0.2.15 via 10.0.2.2");
        byte* mac = stackalloc byte[6];
        Check(Arp.Resolve(Stack.Gateway, mac), "net: ARP resolves the gateway");
        byte ttl = 0;
        int bytes = 0;
        Icmp.SendEcho(Stack.Gateway, 7001, 32);
        Check(Icmp.WaitReply(7001, 1000, out ttl, out bytes) && bytes == 40, "net: the gateway answers ping");
        Icmp.SendEcho(0x7F000001, 7002, 1000);
        Check(Icmp.WaitReply(7002, 1000, out ttl, out bytes) && bytes == 1008, "net: ping over loopback (127.0.0.1)");

        int a = Udp.Bind(0, 0);
        int b = Udp.Bind(4444, 0);
        Check(a >= 0 && b >= 0 && Udp.Bind(4444, 0) == (int)Process.ErrExists, "udp: bind; a taken port is refused");
        byte* buf = stackalloc byte[64];
        Check(Udp.SendTo(a, Stack.Address, 4444, Str.Bytes("hello udp"), 9) == 9, "udp: send to our own address");
        uint from = 0;
        ushort port = 0;
        long n = Udp.ReceiveFrom(b, buf, 64, out from, out port, 1000);
        Check(n == 9 && buf[0] == 'h' && buf[8] == 'p' && from == Stack.Address && port == Udp.PortOf(a), "udp: the datagram arrives with its sender");
        Check(Udp.ReceiveFrom(b, buf, 64, out from, out port, 50) == 0, "udp: an empty queue times out");
        Udp.Close(a);
        Udp.Close(b);
        TcpLoopback();
    }

    const int TcpBytes = 100000;
    static int _tcpListener;
    static ulong _tcpServerSum;
    static long _tcpServerCount;
    static Semaphore _tcpServerDone;

    /// Accepts one connection, sums what arrives until the client closes, answers "count sum", closes.
    static void TcpServer(ulong unused)
    {
        int h = Tcp.Accept(_tcpListener);
        byte* buf = stackalloc byte[1000];
        long count = 0;
        ulong sum = 0;
        if (h >= 0) {
            loop {
                long n = Tcp.Receive(h, buf, 1000);
                if (n <= 0)
                    break;
                for (long i = 0; i < n; i++)
                    sum = sum * 31 + buf[i];
                count += n;
            }
            Stack.Put32(buf, (uint)count);
            Stack.Put32(buf + 4, (uint)sum);
            Tcp.Send(h, buf, 8);
            Tcp.Close(h);
        }
        _tcpServerCount = count;
        _tcpServerSum = sum;
        _tcpServerDone.Signal();
    }

    static void TcpLoopback()
    {
        _tcpListener = Tcp.Listen(7777, 0);
        Check(_tcpListener >= 0 && Tcp.Listen(7777, 0) == (int)Process.ErrExists, "tcp: listen; the port is then taken");
        Thread.Start("tcp-server", &TcpServer);
        int c = Tcp.Connect(0x7F000001, 7777, 0);
        Check(c >= 0, "tcp: connect over loopback (handshake)");
        byte* data = (byte*)Heap.Alloc(TcpBytes);
        defer Heap.Free(data);
        ulong sum = 0;
        for int i in 0..TcpBytes {
            data[i] = (byte)(i * 13 + (i >> 10));
            sum = sum * 31 + data[i];
        }
        long sent = 0;
        while (c >= 0 && sent < TcpBytes) {   // uneven pieces
            int piece = TcpBytes - sent < 7000 ? (int)(TcpBytes - sent) : 7000;
            long n = Tcp.Send(c, data + sent, piece);
            if (n <= 0)
                break;
            sent += n;
        }
        Check(sent == TcpBytes, "tcp: 100 KB sent through 16 KiB buffers (flow control)");
        // Half close: our FIN tells the server we are done; its answer still arrives.
        byte* reply = stackalloc byte[16];
        long got = 0;
        if (c >= 0) {
            Tcp.Shutdown(c);
            loop {
                long n = Tcp.Receive(c, reply + got, 16 - (int)got);
                if (n <= 0)
                    break;
                got += n;
            }
            Tcp.Close(c);
        }
        _tcpServerDone.Wait();
        Tcp.Close(_tcpListener);
        Check(_tcpServerCount == TcpBytes && _tcpServerSum == sum, "tcp: every byte arrived, in order");
        Check(got == 8 && Stack.Get32(reply) == TcpBytes && Stack.Get32(reply + 4) == (uint)sum, "tcp: half close; the answer comes back, then end of stream");
        Check(Tcp.Connect(0x7F000001, 7778, 0) == (int)Process.ErrNotFound, "tcp: a closed port refuses (RST)");
    }

    static void UserMode()
    {
        if (Kernel.Info->Hosted || !Vfs.Exists("/bin/usertest"))
            return;   // host mode, or a boot medium without the initrd
        Process.SetFaultReports(_verbose);
        defer Process.SetFaultReports(true);

        long code = RunAndWait("usertest", _verbose ? "-v alpha beta" : "alpha beta");
        Check(code == 42, "user: usertest passes its own checks in ring 3 (syscalls, argv, heap, FPU, spawn/wait)");

        ulong free = Pages.FreeCount();
        ulong heap = Heap.UsedBytes();
        Check(RunAndWait("usertest", "pf") == Process.KilledBase + 14, "user: a null dereference kills only that process (#PF → 142)");
        Check(RunAndWait("usertest", "kernel") == Process.KilledBase + 14, "user: kernel memory is out of reach of ring 3");
        Check(RunAndWait("usertest", "gp") == Process.KilledBase + 13, "user: a privileged instruction (cli) → #GP → killed");
        Check(RunAndWait("usertest", "ud") == Process.KilledBase + 6, "user: an invalid opcode → #UD → killed");
        Check(RunAndWait("usertest", "child") == 7, "user: the exit code reaches the kernel");
        Check(RunAndWait("usertest", "texit") == 9, "user: exit() in a second thread ends the whole process");
        Check(RunAndWait("usertest", "tfault") == Process.KilledBase + 14, "user: a fault in a second thread ends the whole process");
        Check(KillAfter("spin", 20) == Process.ExitKilled, "user: kill ends a program spinning in ring 3");
        Check(KillAfter("sleep", 20) == Process.ExitKilled, "user: kill cuts a sleep short");
        Check(KillAfter("read", 20) == Process.ExitKilled, "user: kill ends a program waiting for the keyboard");
        Check(KillAfter("parent", 20) == Process.ExitKilled, "user: kill ends a program waiting for its child");
        Check(KillAfter("piperead", 20) == Process.ExitKilled, "user: kill ends a program waiting on a pipe");
        KillOrphans();
        Check(Churn(), "user: 8 programs map memory and exit at once on every CPU (page allocator under contention)");
        Check(CtrlC() == Process.ExitInterrupted, "user: Ctrl+C ends the foreground program (130)");
        Check(Process.Foreground() == 0, "user: the console returns to the kernel");
        Check(Process.Start("no-such-program") == Process.ErrNotFound, "user: starting a missing program fails cleanly");
        Check(Process.Count() == 0, "user: every process was reaped");
        if (Stack.Up) {
            Thread.Sleep(250);   // socket closes are applied by net-timer
            int open = 0;
            lock (Stack.Lock) {
                for int i in 0..Tcp.Connections {
                    TcpState s = Tcp.Table[i].State;
                    if (Tcp.Table[i].Used && (s == TcpState.Listen || s == TcpState.Established))
                        open++;
                }
                for int i in 0..Udp.Sockets {
                    if (Udp.Table[i].Used)
                        open++;
                }
            }
            Check(open == 0, "user: the programs' sockets are closed when they exit");
        }
        Check(Pages.FreeCount() == free && Heap.UsedBytes() == heap, "user: address spaces and process records are freed completely");
    }

    static bool Churn()
    {
        long* pids = stackalloc long[8];
        for int i in 0..8 { pids[i] = Process.Start("usertest", "churn"); }
        bool ok = true;
        for int i in 0..8 { ok &= pids[i] > 0 && Process.Wait((uint)pids[i]) == 0; }
        return ok;
    }

    static uint _victim;
    static ulong _delay;

    static void Killer(ulong unused)
    {
        Thread.Sleep(_delay);
        Process.Kill(_victim);
    }

    static long KillAfter(string mode, ulong ms)
    {
        long pid = Process.Start("usertest", mode);
        if (pid <= 0)
            return pid;
        _victim = (uint)pid;
        _delay = ms;
        Thread.Start("killer", &Killer);
        return Process.Wait((uint)pid);
    }

    /// `usertest parent` leaves a sleeping child behind when it is killed: the orphan is detached,
    /// so killing it must free it without anyone waiting.
    static void KillOrphans()
    {
        ProcessInfo p = default;
        for (uint i = 0; Process.GetInfo(i, out p); i++)
            Process.Kill(p.Pid);
        for int tries in 0..100 {
            if (Process.Count() == 0)
                break;
            Thread.Sleep(1);
        }
    }

    static void PressCtrlC(ulong unused)
    {
        Thread.Sleep(20);
        Process.InterruptForeground();   // what the keyboard driver does on Ctrl+C
    }

    static long CtrlC()
    {
        long pid = Process.Start("usertest", "spin");
        if (pid <= 0)
            return pid;
        Thread.Start("ctrl-c", &PressCtrlC);
        return Process.Wait((uint)pid);   // waiting makes it the foreground process
    }
}
